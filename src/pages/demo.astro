---
// /demo/: Bridle in WordPress Playground (public/demo/blueprint.json).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/ui/Section.astro';
import HeadingPair from '../components/ui/HeadingPair.astro';
import Points from '../components/Points.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';
import { DEMO } from '../data/site';

const page = PAGES.demo;
const tries = [
  { title: 'Home', text: 'Four replies, ready to send.' },
  { title: 'Inbox', text: 'Open one. Press Send.' },
  { title: 'Chat', text: 'Ask the chat a question.' },
];
const notes = [
  'The AI here is a stand-in. It answers from the demo’s docs.',
  'The sample mail is already in.',
  'Free plugin only. It’s gone when you close the tab.',
];
---
<Base title={page.title} description={page.description} crumbs={[{ name: 'Live demo', path: page.path }]}>
  <PageHero
    title={['Try Bridle in your browser', 'Nothing to install']}
    lead="A sample inbox and chat. Ready in about 30 seconds."
    shot={{ name: 'inbox-groups', width: 820, height: 566, alt: 'The demo’s Inbox in Bridle: four replies ready to send.' }}
    cta={{ href: DEMO.url, label: 'Open the live demo' }}
    more={{ href: '#join', label: 'Join the waitlist' }}
  />

  <Section labelledby="h-try">
    <HeadingPair id="h-try" first="Three things to try" second="A minute each" class="opener" />
    <Points items={tries} numbered />
  </Section>

  <Section labelledby="h-notes">
    <HeadingPair id="h-notes" first="A demo" second="Not your site" class="opener" />
    <ul class="grid gap-2.5">{notes.map((n) => <li class="text-[16.5px] leading-snug">{n}</li>)}</ul>
  </Section>

  <Closing wrap />
</Base>
