---
// /demo/: Bridle in WordPress Playground (public/demo/blueprint.json), in the
// site's own parts: a hero with the app picture, three things to try, and
// what the demo is not.
import Base from '../layouts/Base.astro';
import Art from '../components/b/Art.astro';
import Shot from '../components/b/Shot.astro';
import Fin from '../components/b/Fin.astro';
import { PAGES } from '../data/pages';
import { DEMO } from '../data/site';

const page = PAGES.demo;
const tries = [
  { title: 'Home', text: 'Four replies, ready to send.' },
  { title: 'Inbox', text: 'Open one. Press Send.' },
  { title: 'Chat', text: 'Ask the chat a question.' },
];
const notes = [
  'The AI here is a stand-in. It answers from the demo’s docs.',
  'The sample mail is already in.',
  'The demo has the core tools. Live chat and order lookups need a real site.',
  'It runs in your browser and is gone when you close the tab.',
];
---
<Base title={page.title} description={page.description} crumbs={[{ name: 'Live demo', path: page.path }]}>
  <div class="wrap stack-sections">
    <section class="b-hero" aria-labelledby="h-hero">
      <div class="b-hpan b-inner">
        <h1 class="h1" id="h-hero">Try Bridle in your browser.</h1>
        <p class="lead">A sample inbox and chat. Nothing to install. Ready in about 30 seconds.</p>
        <div class="ctas"><a class="b1" href={DEMO.url} target="_blank" rel="noopener">Open the live demo</a><a class="b2" href="/pricing/">Buy Bridle</a></div>
        <Art seed={19} />
      </div>
      <div class="b-stage"><div class="b-wpwin b-shotimg"><Shot name="app-inbox-wide" eager /></div></div>
    </section>

    <section aria-labelledby="h-try">
      <div class="shead"><h2 class="h2" id="h-try">Three things to try</h2><p class="lead">A minute each.</p></div>
      <ol class="b-steps3">{tries.map((t) => <li><b>{t.title}</b><span>{t.text}</span></li>)}</ol>
    </section>

    <section aria-labelledby="h-notes">
      <div class="shead"><h2 class="h2" id="h-notes">Good to know</h2><p class="lead">It is a demo, not your site.</p></div>
      <div class="b-facts">{notes.map((n) => <div>{n}</div>)}</div>
    </section>

    <Fin title="Now put it on your own site" />
  </div>
</Base>
