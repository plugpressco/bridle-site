---
// /chat/: Bridle Chat, free in Bridle (plugin #114, follow-up #120). Every
// claim here is in the plugin's AGENTS.md §6 "Bridle Chat".
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Block from '../components/feature/Block.astro';
import ProLine from '../components/feature/ProLine.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';

const page = PAGES.chat;
---
<Base title={page.title} description={page.description} crumbs={[{ name: 'Bridle Chat', path: page.path }]}>
  <PageHero
    title={['Answers your visitors now.', 'Even at 3 am.']}
    lead="Bridle Chat answers from your docs. Anything hard comes to you."
    shot={{ name: 'chat-answer', width: 400, height: 680, alt: 'Bridle’s chat on a website, answering a question with a numbered source.' }}
    more={{ href: '/demo/', label: 'Try the live demo' }}
  />

  <div class="wrap stack-sections tones fpage">
    <Block
      id="answers"
      title="Answers with proof, not guesses."
      sub="Every answer comes from your docs, pages and past replies, with its source."
      items={[
        { icon: 'i-book', name: 'Looks it up', text: 'In your docs, pages and old replies.' },
        { icon: 'i-check-circle', name: 'Won’t guess', text: 'Not sure? It says so and hands over.' },
        { icon: 'i-sparkles', name: 'Fits your site', text: 'Your colour and icon. It says it is an AI.' },
      ]}
    />
    <Block
      id="handoff"
      title="When it can’t answer, you can."
      sub="Hard questions come to your Inbox. You reply where they are."
      items={[
        { icon: 'i-message', name: 'In the chat', text: 'If they are still on your site.' },
        { icon: 'i-inbox', name: 'Or by email', text: 'If they already left.' },
        { icon: 'i-clock', name: 'A real wait time', text: 'Based on how fast you reply.' },
      ]}
    />
    <ProLine title="More sites? Get Pro." text="Put the chat on all your sites and add live chat." />
  </div>
  <Closing title="Let the chat answer." second="You take the hard ones." source="chat" wrap />
</Base>
