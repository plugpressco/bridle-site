---
// /chat/: Bridle Chat, free in Bridle. Big screen rows like /inbox/. Facts from the plugin's AGENTS.md §6.
import Base from '../layouts/Base.astro';
import Hero from '../components/feature/Hero.astro';
import Rows from '../components/feature/Rows.astro';
import Checklist from '../components/feature/Checklist.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';
const page = PAGES.chat;
const rows = [{"id": "sources", "title": "Answers with its source.", "text": "Every answer comes from what you wrote and shows where it came from. Visitors can check it, and so can you.", "points": ["Your docs, pages and past replies", "A numbered source under each answer", "Says it is an AI"], "ui": "<div class=\"mq\" style=\"padding:18px;gap:12px\"><div class=\"mq-b us\">Can I use it on a staging site?</div><div class=\"mq-b them\">Staging and local sites don’t count against your licence.<br><small style=\"color:var(--color-muted-foreground)\">1 · Use it on a staging site</small></div></div>"}, {"id": "no-guess", "title": "It won’t guess.", "text": "When the answer isn’t in your docs, Bridle says so and asks for a person. Refunds and upset people go straight to you.", "ui": "<div class=\"mq\" style=\"padding:18px;gap:12px\"><div class=\"mq-b us\">Do you ship to Canada?</div><div class=\"mq-b them\">I’m not sure. A person will reply here.</div></div>"}, {"id": "handoff", "title": "You reply where they are.", "text": "The chat lands in your Inbox. Reply in the chat if they are still on your site, or by email if they left. They see a real wait time.", "points": ["Reply in the chat", "Or by email", "A wait time based on how fast you reply"], "ui": "<div class=\"mq\"><div class=\"mq-r\"><div class=\"mq-l\"><b>In the chat</b><span class=\"mpill ok\">Still on your site</span></div></div><div class=\"mq-r\"><div class=\"mq-l\"><b>By email</b><span class=\"mpill\">Left the site</span></div></div></div>"}];
---
<Base title={page.title} description={page.description} crumbs={[{ name: 'Chat', path: page.path }]}>
  <Hero title={["Answers your visitors now.", "Even at 3 am."]} lead={"Bridle Chat sits on your site and answers from your docs, pages and past replies. When it isn’t sure, it hands the chat to you."} shot={{"name": "chat-answer", "width": 400, "height": 680, "alt": "Bridle’s chat on a website, answering a question with a numbered source."}} center more={{ href: '/demo/', label: 'Try the live demo' }} />
  <div class="wrap stack-sections fpage">
    <Rows rows={rows} />
    <Checklist id="all" title={"Everything in the chat."} free={["Answers from your docs, pages and past replies", "Shows the source of each answer", "Never guesses, hands over to a person", "Reply in the chat or by email", "A real wait time", "Says it is an AI, blocks spam bots", "Your colour and icon"]} pro={["Chat on your other sites", "Live chat while they are still there", "Business hours", "1,000 to 10,000 AI answers included"]} />
  </div>
  <Closing title={"Let the chat answer."} second={"You take the hard ones."} source="chat" wrap />
</Base>
