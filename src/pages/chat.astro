---
// /chat/: the chat on your site (design: 02-pages.html).
import Base from '../layouts/Base.astro';
import FeatureHero from '../components/b/FeatureHero.astro';
import Facts from '../components/b/Facts.astro';
import Prod from '../components/b/Prod.astro';
import Next3 from '../components/b/Next3.astro';
import Fin from '../components/b/Fin.astro';
import { PAGES } from '../data/pages';
const page = PAGES.chat;
---
<Base title={page.title} description={page.description} crumbs={[{ name: 'Chat', path: page.path }]}>
  <div class="wrap stack-sections">
    <FeatureHero name="Chat" glyph="bubble" title="Answers visitors on your site, day and night" lead="A chat bubble that answers from your docs. When it is stuck, it hands over to you."
      frames={['bubble', 'face', 'person']} steps={['A visitor asks', 'Bridle answers from your docs', 'Stuck? It hands over to you']} shot="chat-both" frame="duo" seed={31} />
    <Facts items={['One 7 KB script', 'Works with any theme', 'Says it is an AI', 'Anyone can ask for a person']} />
    <section aria-label="What Chat does"><div class="b-prods">
      <Prod icon="i-book" name="Answers" claim="It answers from your docs." shot="tool-chat" points={['Shows the doc behind each answer', 'Does not guess when your docs are silent', 'Follows up by email if they leave']} />
      <Prod icon="i-user" name="Handover" claim="It hands over when it is stuck." shot="chat-handover" points={['The chat lands in your inbox', 'You see everything already said', 'Answer it like any email']} />
      <Prod icon="i-live" name="Live chat" claim="Jump in live, on every site." shot="chat-live" points={['Live chat while they are still there', 'Set your hours. It says when you are back.', 'One line of code adds chat to your other sites']} />
    </div></section>
    <Next3 not="chat" />
    <Fin title="Put a chat on your site that knows your docs" />
  </div>
</Base>
