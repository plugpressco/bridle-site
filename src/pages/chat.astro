---
// /chat/: Bridle Chat, free in Bridle (plugin #114, follow-up #120). Every
// claim here is in the plugin's AGENTS.md §6 "Bridle Chat".
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ChatDemo from '../components/ChatDemo.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';
import { PRO } from '../data/site';

const page = PAGES.chat;
const how = [
  { title: 'It looks it up', text: 'In your docs, pages and old replies.' },
  { title: 'It checks', text: 'Not sure? It won’t guess.' },
  { title: 'It hands off', text: 'Refunds and angry people go to you.' },
];
const after = [
  { icon: 'i-message', title: 'In the chat', text: 'If they are still on your site.' },
  { icon: 'i-inbox', title: 'Or by email', text: 'If they already left.' },
  { icon: 'i-clock', title: 'A real wait time', text: 'Based on how fast you reply.' },
];
const handled = ['Says it is an AI', 'Blocks spam bots', 'Your colour, your icon'];
---
<Base title={page.title} description={page.description} crumbs={[{ name: 'Bridle Chat', path: page.path }]}>
  <PageHero
    eyebrow="Bridle Chat · free"
    title={['A chat that answers', 'From what you wrote']}
    lead="It answers visitors from your docs. The rest come to you."
    art="chat"
    more={{ href: '#demo', label: 'See it answer' }}
  />

  <section class="block" id="demo" aria-labelledby="h-demo">
    <div class="head">
      <p class="eyebrow">On your site</p>
      <h2 id="h-demo"><span>Answers in seconds</span><span class="g">Or finds you</span></h2>
    </div>
    <div class="wrap"><ChatDemo /></div>
  </section>

  <section class="block" aria-labelledby="h-how">
    <div class="head">
      <p class="eyebrow">How it works</p>
      <h2 id="h-how"><span>Look, check, answer</span><span class="g">Or pass it to you</span></h2>
    </div>
    <div class="wrap flush">
      <div class="grid">
        {how.map((h, i) => <div><span class="num">0{i + 1}</span><h3>{h.title}</h3><p>{h.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="h-after">
    <div class="head">
      <p class="eyebrow">When you take over</p>
      <h2 id="h-after"><span>You reply from your Inbox</span><span class="g">They get it anywhere</span></h2>
    </div>
    <div class="wrap flush">
      <div class="grid">
        {after.map((a) => <div><span class="ico"><svg class="i"><use href={`#${a.icon}`} /></svg></span><h3>{a.title}</h3><p>{a.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="h-handled">
    <div class="wrap duo">
      <div>
        <p class="eyebrow">Built in</p>
        <h2 id="h-handled"><span>Already done</span><span class="g">Just switch it on</span></h2>
      </div>
      <ul class="ticks">{handled.map((f) => <li><svg class="i"><use href="#i-check" /></svg>{f}</li>)}</ul>
    </div>
  </section>

  <section class="block" aria-labelledby="h-pro">
    <div class="head">
      <p class="eyebrow">With Bridle Pro</p>
      <h2 id="h-pro"><span>One Inbox for every site</span><span class="g">And live chat too</span></h2>
    </div>
    <div class="wrap duo">
      {PRO.features.slice(0, 2).map((f) => (
        <div class="card">
          <span class="ico blue"><svg class="i"><use href={`#${f.icon}`} /></svg></span>
          <h3>{f.name}</h3>
          <p>{f.text}</p>
          <a class="tlink blue" href="/pro/">See Bridle Pro</a>
        </div>
      ))}
    </div>
  </section>

  <Closing line1="Let the chat answer" line2="You take the hard ones" source="chat" />
</Base>
