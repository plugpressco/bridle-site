---
// /chat/: Bridle Chat, free in Bridle. Explained part by part like /inbox/. Facts from the plugin's AGENTS.md §6.
import Base from '../layouts/Base.astro';
import Hero from '../components/feature/Hero.astro';
import Story from '../components/feature/Story.astro';
import AllList from '../components/feature/AllList.astro';
import ProLine from '../components/feature/ProLine.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';
const page = PAGES.chat;
const cards = [{"title": "Answers with its source", "text": "Every answer comes from what you wrote and shows where it came from. Visitors can check it, and so can you.", "ui": "<div class=\"mq\" style=\"padding:14px;gap:10px\"><div class=\"mq-b us\">Can I use the slider on a staging site?</div><div class=\"mq-b them\">Staging and local sites don’t count against your licence.<br><small style=\"color:var(--color-muted-foreground)\">1 · Use it on a staging site</small></div></div>"}, {"title": "It won’t guess", "text": "When the answer isn’t in your docs, Bridle says so and asks for a person. A wrong answer costs more than a slow one.", "ui": "<div class=\"mq\" style=\"padding:14px;gap:10px\"><div class=\"mq-b us\">Do you ship to Canada?</div><div class=\"mq-b them\">I’m not sure. A person will reply here.</div></div>"}, {"title": "You take over anywhere", "text": "Hard questions land in your Inbox. Reply in the chat if they are still on your site, or by email if they left.", "ui": "<div class=\"mq\"><div class=\"mq-r\"><div class=\"mq-l\"><b>In the chat</b><span class=\"mpill ok\">On your site</span></div></div><div class=\"mq-r\"><div class=\"mq-l\"><b>By email</b><span class=\"mpill\">Left the site</span></div></div><div class=\"mq-r\"><small>Wait time</small>Based on how fast you reply</div></div>"}];
const all = [{"icon": "i-book", "label": "Answers from your docs"}, {"icon": "i-check-circle", "label": "Sources shown"}, {"icon": "i-user", "label": "Hands off to a person"}, {"icon": "i-message", "label": "Reply in the chat"}, {"icon": "i-inbox", "label": "Reply by email"}, {"icon": "i-clock", "label": "Real wait time"}, {"icon": "i-sparkles", "label": "Says it is an AI"}, {"icon": "i-shield", "label": "Blocks spam bots"}, {"icon": "i-globe", "label": "Your colour and icon"}, {"icon": "i-live", "label": "Live chat", "pro": true}, {"icon": "i-clock", "label": "Business hours", "pro": true}, {"icon": "i-globe", "label": "Chat on other sites", "pro": true}];
---
<Base title={page.title} description={page.description} crumbs={[{ name: 'Chat', path: page.path }]}>
  <Hero
    title={["Answers your visitors now.", "Even at 3 am."]}
    lead={"Bridle Chat sits on your site and answers from your docs, pages and past replies. When it isn’t sure, it hands the chat to you."}
    shot={{"name": "chat-answer", "width": 400, "height": 680, "alt": "Bridle’s chat on a website, answering a question with a numbered source."}}
    more={{ href: '/demo/', label: 'Try the live demo' }}
  />
  <div class="wrap stack-sections fpage">
    <Story id="how" title={"How the chat works for you."} cards={cards.slice(0, 3)} />
    {cards.length > 3 && <Story cards={cards.slice(3)} more />}
    <AllList id="all" title={"Everything in the chat."} items={all} />
    <ProLine title={"More sites? Get Pro."} text={"Put the chat on all your sites and add live chat."} />
  </div>
  <Closing title={"Let the chat answer."} second={"You take the hard ones."} source="chat" wrap />
</Base>
