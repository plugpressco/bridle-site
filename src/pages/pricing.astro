---
// /pricing/. Kept short and plain (owner, 12 November 2026: "simple offer easy
// understand", "more compact", "easy copy to read"): the price as one card on
// the dot mountains (PricePanel), every tool in four cells, and the questions
// about paying. AI packs are not shown here: they are sold inside
// the plugin (owner, 12 November 2026). The buy button opens a Polar
// checkout. /pro/ redirects here. This page never calls anything free.
import Base from '../layouts/Base.astro';
import PricePanel from '../components/b/PricePanel.astro';
import Qa from '../components/b/Qa.astro';
import Fin from '../components/b/Fin.astro';
import { TOOLS } from '../components/b/tools';
import { PAGES } from '../data/pages';
import { PRICING_FAQ, faqLd } from '../data/faq';
import { IN_THE_LICENCE, ALSO } from '../data/licence';
import { SITE, PLAN, PRICE } from '../data/site';

const page = PAGES.pricing;
const jsonLd = [
  {
    '@type': 'Product',
    name: 'Bridle',
    description: SITE.definition,
    brand: { '@type': 'Brand', name: SITE.name },
    offers: {
      '@type': 'Offer', name: `Pay once, ${PLAN.sites} sites`, price: String(PRICE), priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: `${SITE.url}/pricing/`,
    },
  },
  faqLd(PRICING_FAQ),
];
---
<Base title={page.title} description={page.description} jsonLd={jsonLd} crumbs={[{ name: 'Pricing', path: page.path }]}>
  <div class="wrap stack-sections">
    <section class="b-hero b-flat b-ppsec" aria-labelledby="h-hero" id="plans">
      <PricePanel as="h1" id="h-hero" seed={7} />
    </section>

    <section aria-labelledby="h-in">
      <div class="shead"><h2 class="h2" id="h-in">Every tool is in it</h2><p class="lead">There is no bigger plan.</p></div>
      <div class="b-in4">
        {IN_THE_LICENCE.map((t) => (
          <div>
            <span class="b-pname"><i><svg class="i" aria-hidden="true"><use href={`#${TOOLS[t.tool].icon}`} /></svg></i>{TOOLS[t.tool].name}</span>
            <ul>{t.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="small b-after-note">Also in it: {ALSO}</p>
    </section>

    <Qa items={PRICING_FAQ} title="Questions about paying" />

    <Fin title="Buy Bridle today" buy="#plans" />
  </div>
</Base>
