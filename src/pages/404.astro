---
// Page not found. Not for search engines.
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import HeadingPair from '../components/ui/HeadingPair.astro';
import Button from '../components/ui/Button.astro';
---
<Base title="Page not found | Bridle" description="This page doesn’t exist. Go back to the Bridle home page." noindex waitlist={false}>
  <Section inner="grid min-h-[52vh] content-center justify-items-start gap-6">
    <svg class="i size-11 text-brand-500" aria-hidden="true"><use href="#i-help" /></svg>
    <HeadingPair as="h1" size="title" first="This page got away" second="The link may be old or wrong" />
    <Button variant="link" href="/">Go to the home page</Button>
  </Section>
</Base>
