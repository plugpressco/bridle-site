---
// /pro/: Bridle Pro. One plan, every site, pay once; the price goes up every
// 20 sales (src/data/deal.json, decided 2026-11-09). Until launch every
// button joins the waitlist (CHECKOUT_OPEN in src/data/site.ts).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Features from '../components/Features.astro';
import Price from '../components/Price.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';
import { PRO_FAQ } from '../data/faq';
import { SITE, AI, PRO, money, sitesLabel } from '../data/site';

const page = PAGES.pro;
const jsonLd = [
  {
    '@type': 'Product',
    name: 'Bridle Pro',
    description: 'Adds chat on your other sites, live chat, business hours, order lookups, missing answers and team reminders to Bridle, the AI support agent for WordPress.',
    brand: { '@type': 'Brand', name: SITE.name },
    offers: PRO.plans.map((p) => ({ '@type': 'Offer', name: `Pay once, ${sitesLabel(p.sites)}`, price: String(p.base), priceCurrency: 'USD', availability: 'https://schema.org/PreOrder', url: `${SITE.url}/pro/#price` })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: PRO_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={page.title} description={page.description} jsonLd={jsonLd} crumbs={[{ name: 'Bridle Pro', path: page.path }]}>
  <PageHero
    eyebrow="Bridle Pro"
    title={['Pay once', 'Keep it for good']}
    lead="Bridle is free. Pro adds more for a growing shop."
    art="key"
    cta={{ href: '#price', label: 'See the price' }}
    more={{ href: '#join', label: 'Join the waitlist' }}
  />

  <section class="block" aria-labelledby="h-adds">
    <div class="head">
      <p class="eyebrow">What you get</p>
      <h2 id="h-adds"><span>Six things Pro adds</span><span class="g">Free never loses a thing</span></h2>
    </div>
    <div class="wrap"><Features items={PRO.features} tone="blue" /></div>
  </section>

  <section class="block" id="price" aria-labelledby="h-price">
    <div class="head">
      <p class="eyebrow">The price</p>
      <h2 id="h-price"><span>Early buyers pay less</span><span class="g">It goes up every 20 sales</span></h2>
    </div>
    <div class="wrap"><Price /></div>
  </section>

  <section class="block" id="ai" aria-labelledby="h-ai">
    <div class="head">
      <p class="eyebrow">Bridle AI</p>
      <h2 id="h-ai"><span>No AI key?</span><span class="g">{AI.free} free answers a month</span></h2>
    </div>
    <div class="wrap">
      <p class="lead">Every site gets {AI.free} free AI answers a month. Pro comes with more. Need extra? Top up from {money(AI.topUpFrom)} inside Bridle.</p>
    </div>
  </section>

  <Faq items={PRO_FAQ} title={['Questions', 'About Pro']} />
  <Closing line1="Early buyers pay less" line2="Be one of them" lead="Join the waitlist. We email you on launch day." source="pro" />
</Base>

<style is:global>
  .after { margin-top: 18px; }
</style>
