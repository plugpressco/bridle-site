---
// /pro/: Bridle Pro and the prices (BRIDLE-PRO.md §11, decided 2026-11-02).
// Nothing is sold before launch: every button joins the waitlist.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';
import { PRO_FAQ } from '../data/faq';
import { SITE, AI, PRO, money, count } from '../data/site';

const page = PAGES.pro;
const icons = ['i-globe', 'i-live', 'i-bag', 'i-help'];
const includes = ['Every Pro feature', 'Updates for life', `${count(AI.proGift)} AI answers`, `${PRO.refundDays}-day refund`];
const jsonLd = [
  {
    '@type': 'Product',
    name: 'Bridle Pro',
    description: 'A plugin that adds chat on your other sites, live takeover, order lookups and unanswered questions to Bridle, the AI support agent for WordPress.',
    brand: { '@type': 'Brand', name: SITE.name },
    offers: PRO.plans.map((p) => ({ '@type': 'Offer', name: `Founders’ lifetime, ${p.label.toLowerCase()}`, price: String(p.lifetime[0]), priceCurrency: 'USD', availability: 'https://schema.org/PreOrder', url: `${SITE.url}/pro/#pricing` })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: PRO_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={page.title} description={page.description} jsonLd={jsonLd} crumbs={[{ name: 'Bridle Pro', path: page.path }]}>
  <PageHero
    eyebrow="Bridle Pro"
    title={['Bridle is free', 'Pro when you grow']}
    lead={`Pay once. Founders’ price for the first ${PRO.total}.`}
    art="key"
    more={{ href: '#pricing', label: 'See pricing' }}
  />

  <section class="block" aria-labelledby="h-adds">
    <div class="head">
      <p class="eyebrow">Features</p>
      <h2 id="h-adds"><span>What Pro adds</span><span class="g">Never taken from free</span></h2>
    </div>
    <div class="wrap flush">
      <div class="grid" style="--n:4">
        {PRO.features.map((f, i) => <div><span class="ico blue"><svg class="i"><use href={`#${icons[i]}`} /></svg></span><h3>{f.title}</h3><p>{f.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="block" id="pricing" aria-labelledby="h-pricing">
    <div class="head">
      <p class="eyebrow">Founders’ lifetime</p>
      <h2 id="h-pricing"><span>Pay once</span><span class="g">Price rises every {PRO.step} sold</span></h2>
    </div>
    <div class="wrap plans">
      {PRO.plans.map((p, i) => (
        <div class:list={['card', { dark: i === 1 }]}>
          <h3>{p.label}</h3>
          <p class="big">{money(p.lifetime[0])} <small>once · then {p.lifetime.slice(1).map(money).join(', ')}</small></p>
          <ul class="ticks">{includes.map((f) => <li><svg class="i"><use href="#i-check" /></svg>{f}</li>)}</ul>
          <a class:list={['btn', { ghost: i !== 1 }]} href="#join">Join the waitlist</a>
          <p class="opens">Opens on launch day</p>
        </div>
      ))}
    </div>
    <p class="wrap fine after">After {PRO.total} licences: {PRO.plans.map((p) => money(p.yearly)).join(', ')} a year.</p>
  </section>

  <section class="block" id="ai" aria-labelledby="h-ai">
    <div class="head">
      <p class="eyebrow">Bridle AI</p>
      <h2 id="h-ai"><span>No AI key?</span><span class="g">{AI.free} answers a month free</span></h2>
    </div>
    <div class="wrap">
      <ul class="packs big3">
        {AI.packs.map((p) => <li><b>{money(p.price)}</b><span>{count(p.answers)} answers</span></li>)}
      </ul>
    </div>
  </section>

  <Faq items={PRO_FAQ} title={['Questions', 'About Pro']} />
  <Closing line1="Founders’ price" line2="On launch day" lead="We email you the day it opens." source="pro" />
</Base>

<style is:global>
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .plans .card { display: flex; flex-direction: column; padding: 32px; }
  .plans .card .ticks { margin-bottom: 30px; }
  .plans .card .btn { margin-top: auto; }
  .plans .card.dark .btn { background: var(--paper); color: var(--ink); }
  .plans .card.dark .btn:hover { background: #fff; }
  .plans .opens { margin-top: 12px; font-size: 14px; text-align: center; color: var(--gray); }
  .after { margin-top: 22px; }
  .packs.big3 { margin: 0; }
  .packs.big3 li { padding: 26px 24px; gap: 4px; border-radius: 18px; background: #fff; }
  .packs.big3 b { font-size: 40px; font-weight: 400; letter-spacing: -0.03em; }
  .packs.big3 span { font-size: 16px; color: var(--ink); }
  .packs.big3 small { font-size: 14px; color: var(--muted-foreground); }
  @media (max-width: 860px) {
    .plans { grid-template-columns: minmax(0, 1fr); }
    .packs.big3 { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    .packs.big3 li { grid-template-columns: minmax(0, 1fr); }
    .plans .card { padding: 26px 22px; }
  }
</style>
