---
// Where the waitlist form lands without JavaScript (the function answers a
// plain form post with a 303 here), and where Polar sends a Bridle Pro buyer
// (?checkout_id=…). Not for search engines.
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import HeadingPair from '../components/ui/HeadingPair.astro';
import Button from '../components/ui/Button.astro';
---
<Base title="You’re on the list | Bridle" description="Thanks for joining the Bridle waitlist. We email you the day Bridle is live on WordPress.org." noindex waitlist={false}>
  <Section inner="grid min-h-[52vh] content-center justify-items-start gap-6">
    <svg class="i size-11 text-brand-500" aria-hidden="true"><use href="#i-check-circle" /></svg>
    <HeadingPair as="h1" size="title" first="You’re on the list" second="We email you on launch day" data-thanks />
    <Button variant="link" href="/">Back to Bridle</Button>
  </Section>
</Base>

<script>
  // Back from a Polar checkout: thank the buyer instead.
  if (new URLSearchParams(location.search).has('checkout_id')) {
    const h = document.querySelector('[data-thanks]');
    if (h) h.innerHTML = '<span class="block">Thanks for buying Bridle Pro</span><span class="block text-muted-foreground">Your licence key is in your email</span>';
    document.title = 'Thanks for buying Bridle Pro | Bridle';
  }
</script>
