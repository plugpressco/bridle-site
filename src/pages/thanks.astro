---
// Where Polar sends a buyer after the checkout (?checkout_id=…): a thank-you
// and the three steps to get going. Not for search engines.
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import HeadingPair from '../components/ui/HeadingPair.astro';
import Button from '../components/ui/Button.astro';
import { FREE_URL, WPORG_LIVE, ACCOUNT_URL, SITE } from '../data/site';
---
<Base title="Thanks for buying Bridle | Bridle" description="Thanks for buying Bridle. Your licence key is in your email. Three steps and your help desk is running." noindex>
  <Section inner="grid min-h-[52vh] content-center justify-items-start gap-6">
    <svg class="i size-11 text-foreground" aria-hidden="true"><use href="#i-check-circle" /></svg>
    <HeadingPair as="h1" size="title" first="Thanks for buying Bridle" second="Your licence key is in your email" />
    <ol class="grid gap-2 text-[17px] text-ink-2 list-decimal pl-5">
      <li>Install Bridle: <a class="underline" href={FREE_URL}>{WPORG_LIVE ? 'get it from WordPress.org' : 'download the zip'}</a>.</li>
      <li>Download the Bridle Pro plugin from <a class="underline" href={ACCOUNT_URL}>your account</a> and install it too. It turns on everything in your licence.</li>
      <li>Paste your licence key in Bridle › Settings.</li>
    </ol>
    <p class="text-[16px] text-muted-foreground">Stuck? <a class="underline" href={SITE.support}>Ask us.</a> A person answers.</p>
    <Button variant="link" href="/">Back to Bridle</Button>
  </Section>
</Base>
