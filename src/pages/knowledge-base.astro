---
// /knowledge-base/: Bridle KB, the free help center plugin. Big screen rows like /inbox/. The help center screen is a real Bridle KB (plugpress.io's Bridle docs).
import Base from '../layouts/Base.astro';
import Hero from '../components/feature/Hero.astro';
import Rows from '../components/feature/Rows.astro';
import Checklist from '../components/feature/Checklist.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';
const page = PAGES.kb;
const rows = [{"id": "help-center", "title": "A help center people use.", "text": "Clean pages that fit your theme, with your colour. A doc list on the side, a short summary for each, and search on the / key.", "points": ["Categories", "Your colour, your theme’s font", "Docs under the Bridle menu"], "shot": {"name": "kb-help", "width": 1040, "height": 635, "alt": "A Bridle KB help center."}}, {"id": "smarter", "title": "Every doc makes Bridle smarter.", "text": "Email replies and chat answers come from your docs, with the doc as the source. Add a doc today, and the next answer uses it.", "center": true, "shot": {"name": "draft-sources", "width": 780, "height": 288, "alt": "A Bridle draft with its help doc source under it."}}, {"id": "gaps", "title": "See what it couldn’t answer.", "text": "With Bridle Pro, the questions it couldn’t answer are listed. Turn one into a doc in one click, and it won’t miss it again.", "center": true, "shot": {"name": "pro-gaps", "width": 820, "height": 238, "alt": "Knowledge gaps in Bridle: questions it couldn’t answer, each with Write a doc."}}];
---
<Base title={page.title} description={page.description} crumbs={[{ name: 'Knowledge base', path: page.path }]}>
  <Hero title={["Write it once.", "Bridle answers with it forever."]} lead={"Bridle KB is a free help center for your site. Customers search it on their own, and Bridle reads every doc to answer email and chat."} shot={{"name": "kb-help", "width": 1040, "height": 635, "alt": "A Bridle KB help center: a list of docs on the left and doc cards with a short summary each."}} more={{ href: '/demo/', label: 'Try the live demo' }} />
  <div class="wrap stack-sections fpage">
    <Rows rows={rows} />
    <Checklist id="all" title={"Everything in Bridle KB."} free={["A help center on your site", "Search on the / key", "Categories", "Your colour, your theme’s font", "Docs under the Bridle menu", "Bulk actions", "Read by Bridle for every answer"]} pro={["Missing answers, with “write a doc”", "Live chat and chat on your other sites"]} />
  </div>
  <Closing title={"Write it once."} second={"Let Bridle answer."} source="kb" wrap />
</Base>
