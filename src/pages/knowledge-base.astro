---
// /knowledge-base/: Bridle KB, the free help center plugin. One doc followed on the rein line, like /inbox/. The help center screen is a real Bridle KB (plugpress.io's Bridle docs).
import Base from '../layouts/Base.astro';
import Hero from '../components/feature/Hero.astro';
import Path from '../components/feature/Path.astro';
import Checklist from '../components/feature/Checklist.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';
const page = PAGES.kb;
const steps = [{"title": "You write a doc", "text": "Write it under Bridle → Docs, next to your inbox. Group docs into categories, and sort many at once.", "ui": "<div class=\"mq\"><div class=\"mq-h\">Docs</div><div class=\"mq-r\"><small>Getting started</small>Install and first reply</div><div class=\"mq-r\"><small>Getting started</small>Forward your support email</div><div class=\"mq-r\"><small>Billing</small>Refunds and renewals</div></div>"}, {"title": "Customers find it", "text": "It shows up in a clean help center that fits your theme, with your colour. Press / to search.", "shot": {"name": "kb-help", "width": 1040, "height": 635, "alt": "A Bridle KB help center: a list of docs on the left and doc cards with a short summary each."}}, {"title": "Bridle answers with it", "text": "Email replies and chat answers use your docs, with the doc as the source. Add a doc today, and the next answer uses it.", "ui": "<div class=\"mq\"><div class=\"mq-r blue\"><small>Bridle · Draft</small>Staging and local sites don’t count against your licence.</div><div class=\"mq-r\"><small>Help doc</small>Use it on a staging site</div></div>"}, {"title": "Missing answers show up", "text": "With Bridle Pro, the questions it couldn’t answer are listed. Turn one into a doc in one click.", "shot": {"name": "pro-gaps", "width": 820, "height": 238, "alt": "Knowledge gaps in Bridle: questions it couldn’t answer, each with Write a doc."}}];
---
<Base title={page.title} description={page.description} crumbs={[{ name: 'Knowledge base', path: page.path }]}>
  <Hero title={["Write it once.", "Bridle answers with it forever."]} lead={"Bridle KB is a free help center for your site. Customers search it on their own, and Bridle reads every doc to answer email and chat."} steps={steps.map((s) => s.title)} more={{ href: '/demo/', label: 'Try the live demo' }} />
  <div class="wrap stack-sections fpage">
    <Path id="path" title={"Follow one doc."} steps={steps} />
    <Checklist id="all" title={"Everything in Bridle KB."} free={["A help center on your site", "Search on the / key", "Categories", "Your colour, your theme’s font", "Docs under the Bridle menu", "Bulk actions", "Read by Bridle for every answer"]} pro={["Missing answers, with “write a doc”", "Live chat and chat on your other sites"]} />
  </div>
  <Closing title={"Write it once."} second={"Let Bridle answer."} source="kb" wrap />
</Base>
