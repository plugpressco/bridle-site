---
// The home page. The pictures (hero, product window, dot stories, AI apps
// chat, closing) are the approved v11 page's. One idea per section, short
// plain words (owner, 2026-11-09: "simple, catchy, a 12 year old gets it").
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Product from '../components/home/Product.astro';
import Chat from '../components/home/Chat.astro';
import Agents from '../components/home/Agents.astro';
import Plans from '../components/home/Plans.astro';
import Faq from '../components/ui/Faq.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';
import { FAQ } from '../data/faq';
import { SITE, AI, PRO } from '../data/site';

const page = PAGES.home;
const jsonLd = [
  {
    '@type': 'SoftwareApplication',
    name: SITE.name,
    description: SITE.definition,
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Customer support',
    operatingSystem: 'WordPress',
    url: `${SITE.url}/`,
    license: 'https://www.gnu.org/licenses/gpl-2.0.html',
    publisher: { '@id': `${SITE.companyUrl}/#org` },
    offers: [
      { '@type': 'Offer', name: 'Bridle', price: '0', priceCurrency: 'USD' },
      ...AI.packs.map((p) => ({ '@type': 'Offer', name: `Bridle AI, ${p.answers} answers`, price: String(p.price), priceCurrency: 'USD' })),
      ...PRO.plans.map((p) => ({ '@type': 'Offer', name: `Bridle Pro, pay once, ${p.sites === 1 ? '1 site' : `${p.sites} sites`}`, price: String(p.base), priceCurrency: 'USD', availability: 'https://schema.org/PreOrder', url: `${SITE.url}/pro/#price` })),
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={page.title} description={page.description} jsonLd={jsonLd}>
  <Hero />
  <Product />
  <Chat />
  <Agents />
  <Plans />
  <Faq items={FAQ} />
  <Closing />
</Base>

<script>
  import '../scripts/home.js';
</script>
