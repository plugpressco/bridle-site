---
// The home page (design v3, approved 10 November 2026:
// planning/landing/pages/home/11-design.html). Copy word for word from
// planning/landing/pages/home/08-copy.md, in its order: hero, what it does,
// checks, cost, three steps, the deal, the founder's note, questions,
// closing. One moving picture (the hero), one navy panel, one blue panel.
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Does from '../components/home/Does.astro';
import Checks from '../components/home/Checks.astro';
import Cost from '../components/Cost.astro';
import Steps from '../components/home/Steps.astro';
import Deal from '../components/home/Deal.astro';
import Founder from '../components/home/Founder.astro';
import Faq from '../components/ui/Faq.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';
import { FAQ } from '../data/faq';
import { SITE, AI, PRO, sitesLabel } from '../data/site';

const page = PAGES.home;
const jsonLd = [
  {
    '@type': 'SoftwareApplication',
    name: SITE.name,
    description: SITE.definition,
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Customer support',
    operatingSystem: 'WordPress',
    url: `${SITE.url}/`,
    license: 'https://www.gnu.org/licenses/gpl-2.0.html',
    publisher: { '@id': `${SITE.companyUrl}/#org` },
    offers: [
      { '@type': 'Offer', name: 'Bridle', price: '0', priceCurrency: 'USD' },
      ...AI.packs.map((p) => ({ '@type': 'Offer', name: `Bridle AI, ${p.answers} answers`, price: String(p.price), priceCurrency: 'USD' })),
      ...PRO.plans.map((p) => ({ '@type': 'Offer', name: `Bridle Pro, pay once, ${sitesLabel(p.sites)}`, price: String(p.base), priceCurrency: 'USD', availability: 'https://schema.org/PreOrder', priceValidUntil: PRO.endsAt.slice(0, 10), url: `${SITE.url}/pricing/#plans` })),
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={page.title} description={page.description} jsonLd={jsonLd}>
  <div class="wrap stack-sections">
    <Hero />
    <Does />
    <Checks />
    <Cost id="cost" />
    <Steps />
    <Deal join="#join" />
    <Founder />
    <Faq items={FAQ} title="Questions, answered." />
    <Closing source="footer" />
  </div>
</Base>
