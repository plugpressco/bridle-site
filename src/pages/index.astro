---
// The home page, "tack" design (owner's pick 2026-11-11:
// planning/landing/pages/home/15-home.html): hero with the product, three
// ways every email goes, chat and docs on your site, the pricing table, the
// closing. Serif headings, cream page, crisp product cards.
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Features from '../components/home/Features.astro';
import Example from '../components/home/Example.astro';
import AiApps from '../components/home/AiApps.astro';
import Table from '../components/pricing/Table.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';
import { SITE, AI, PRO, sitesLabel } from '../data/site';

const page = PAGES.home;
const jsonLd = [
  {
    '@type': 'SoftwareApplication',
    name: SITE.name,
    description: SITE.definition,
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Customer support',
    operatingSystem: 'WordPress',
    url: `${SITE.url}/`,
    license: 'https://www.gnu.org/licenses/gpl-2.0.html',
    publisher: { '@id': `${SITE.companyUrl}/#org` },
    offers: [
      { '@type': 'Offer', name: 'Bridle', price: '0', priceCurrency: 'USD' },
      ...AI.packs.map((p) => ({ '@type': 'Offer', name: `Bridle AI, ${p.answers} answers`, price: String(p.price), priceCurrency: 'USD' })),
      ...PRO.plans.map((p) => ({ '@type': 'Offer', name: `Bridle Pro, pay once, ${sitesLabel(p.sites)}`, price: String(p.base), priceCurrency: 'USD', availability: 'https://schema.org/PreOrder', priceValidUntil: PRO.endsAt.slice(0, 10), url: `${SITE.url}/pricing/#plans` })),
    ],
  },
];
---
<Base title={page.title} description={page.description} jsonLd={jsonLd}>
  <div class="wrap stack-sections">
    <Hero />
    <Features />
    <Example />
    <AiApps />
    <Table />
    <Closing title="Let Bridle write." second="You check the hard ones." sub="Free for WordPress. Your support address stays the same." source="footer" />
  </div>
</Base>
