---
// /inbox/: Bridle's email replies, free. Bridle's own page shape (owner, 2026-11-11: "we need our DNA"): one email followed from start to finish on the rein line. Facts from the plugin's AGENTS.md and the Bridle docs.
import Base from '../layouts/Base.astro';
import Hero from '../components/feature/Hero.astro';
import Path from '../components/feature/Path.astro';
import Checklist from '../components/feature/Checklist.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';
const page = PAGES.inbox;
const steps = [{"title": "An email arrives", "text": "Priya writes to support@ about a broken slider. Receipts and newsletters go to Updates, scams to Spam, so her email is easy to see.", "shot": {"name": "app-inbox", "width": 1040, "height": 628, "alt": "The Bridle inbox: replies under Ready to send, and emails under Needs you."}}, {"title": "Bridle writes the reply", "text": "It finds the answer in your docs, pages and past replies, and writes it in plain words. The draft waits inside her email.", "shot": {"name": "conversation-draft", "width": 803, "height": 723, "alt": "A customer email in Bridle with a ready reply under it.", "end": true}}, {"title": "Every fact is checked", "text": "Each quote and link in the draft is checked against where it came from. If something doesn’t hold up, Bridle tells you instead of guessing.", "ui": "<div class=\"mq\"><div class=\"mq-h\">Sources <span class=\"mpill ok\">✓ Verified</span></div><div class=\"mq-r\"><small>Help doc</small>Slider not showing on Safari</div><div class=\"mq-r\"><small>Page</small>Acme Slider → Performance</div></div>"}, {"title": "You send it, or it waits for you", "text": "One click sends it. Refunds, billing and upset customers always wait for a person. Turn on Auto and sure replies send after 15 minutes.", "ui": "<div class=\"mq\"><div class=\"mq-h\">Needs you <small style=\"color:var(--color-muted-foreground)\">2</small></div><div class=\"mq-r\"><div class=\"mq-l\"><b>Daniel Okafor</b><span class=\"mpill warn\">! Upset customer</span></div></div><div class=\"mq-r\"><div class=\"mq-l\"><b>Hannah Lindqvist</b><span class=\"mpill warn\">! Refund</span></div></div><div class=\"mq-seg\"><span>Off</span><span>Draft</span><span class=\"on\">Auto</span></div></div>"}];
---
<Base title={page.title} description={page.description} crumbs={[{ name: 'Inbox', path: page.path }]}>
  <Hero title={["Every email comes with a reply.", "Read it, then send it."]} lead={"Bridle reads each new email, finds the answer in your docs, pages and past replies, and writes the reply. The hard ones wait for you."} steps={steps.map((s) => s.title)} more={{ href: '/demo/', label: 'Try the live demo' }} />
  <div class="wrap stack-sections fpage">
    <Path id="path" title={"Follow one email."} steps={steps} />
    <Checklist id="all" title={"Everything in the Inbox."} free={["Reply drafts from your docs, pages and past replies", "Fact checks on every quote and link", "Auto, with 15 minutes to stop it", "Rewrite and translate", "Inbox, Updates and Spam", "Teammates, notes, bulk actions, shortcuts", "Claude and ChatGPT can draft for you", "3 inboxes per site, your own AI key"]} pro={["10, 25 or unlimited inboxes", "Order and licence lookups", "Late-reply nudges and auto-resolve", "1,000 to 10,000 AI answers included"]} />
  </div>
  <Closing title={"Let Bridle write the replies."} second={"You press send."} source="inbox" wrap />
</Base>
