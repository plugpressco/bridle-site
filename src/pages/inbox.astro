---
// /inbox/: Bridle's email replies, free. Built only from the home page's own sections (owner, 2026-11-11: one design system across the site).
import Base from '../layouts/Base.astro';
import Hero from '../components/feature/Hero.astro';
import Overview from '../components/feature/Overview.astro';
import Split from '../components/feature/Split.astro';
import Closing from '../components/Closing.astro';
import { PAGES } from '../data/pages';
const page = PAGES.inbox;
---
<Base title={page.title} description={page.description} crumbs={[{ name: 'Inbox', path: page.path }]}>
  <div class="wrap stack-sections">
    <Hero title={["Every email comes with a reply.", "Read it, then send it."]} lead={"Bridle reads each new email, finds the answer in your docs and past replies, and writes the reply. The hard ones wait for you."} shot={{"name": "app-inbox", "width": 1040, "height": 628, "alt": "The Bridle inbox: four replies under Ready to send, and two emails under Needs you."}} />
    <Overview id="drafts" title={"Your inbox, mostly done."} sub={"Open an email and the reply is already there."} shot={{"name": "conversation-draft", "width": 875, "height": 724, "alt": "An email from Maya in Bridle, with a ready reply and its help doc source under it."}} points={[{"name": "Knows your business", "text": "It reads your docs, pages, products and past replies."}, {"name": "Every fact checked", "text": "Each quote and link must match its source."}, {"name": "Rewrite or redraft", "text": "Change the tone or the language in one click."}, {"name": "Bring the team", "text": "Add as many teammates as you like. No seat price."}]} />
    <Split id="needs-you" title={"Hard ones wait for you."} sub={"Bridle never sends them."} lines={["Refunds, billing and upset customers are marked and wait under Needs you.", "Receipts go to Updates. Scams go to Spam. Your Inbox shows only people."]} shot={{"name": "inbox-needs", "width": 1112, "height": 220, "alt": "Needs you in Bridle: an email marked Upset customer, and one marked Refund."}} mid />
    <Split id="auto" title={"Auto, when you trust it."} sub={"Off, Draft or Auto, for each inbox."} lines={["With Auto, sure replies send after 15 minutes. You can stop any of them.", "Want more inboxes? Bridle Pro gives 10, 25 or unlimited."]} ui={"<div class=\"mq\"><div class=\"mq-h\">Support inbox</div><div class=\"mq-seg\"><span>Off</span><span>Draft</span><span class=\"on\">Auto</span></div><div class=\"mq-r\"><small>Sure replies</small>Send after 15 minutes</div><div class=\"mq-r\"><small>Refunds, billing, upset customers</small>Always wait for you</div></div>"} flip />
  </div>
  <Closing title={"Let Bridle write the replies."} second={"You press send."} source="inbox" wrap />
</Base>
