---
// /inbox/: the shared inbox (design: planning/landing/redesign/02-pages.html).
import Base from '../layouts/Base.astro';
import FeatureHero from '../components/b/FeatureHero.astro';
import Facts from '../components/b/Facts.astro';
import Prod from '../components/b/Prod.astro';
import Next3 from '../components/b/Next3.astro';
import Fin from '../components/b/Fin.astro';
import { PAGES } from '../data/pages';
const page = PAGES.inbox;
---
<Base title={page.title} description={page.description} crumbs={[{ name: 'Inbox', path: page.path }]}>
  <div class="wrap stack-sections">
    <FeatureHero name="Inbox" glyph="envelope" title="All your support email, inside WordPress" lead="A shared inbox for your team, in the place you already work."
      frames={['envelope', 'bars', 'check']} steps={['An email comes in', 'Bridle sorts it', 'A reply is ready']} shot="inbox-open" frame="conv" seed={17} />
    <Facts items={['No limit on teammates', 'Keyboard shortcuts', 'Select many, like Gmail', 'Trash kept for 30 days']} />
    <section aria-label="What the Inbox does"><div class="b-prods">
      <Prod icon="i-check-circle" name="Sorting" claim="Sorted before you look." shot="inbox-sorted" points={['Ready to send: a reply is already written', 'Needs you: refunds, billing, upset customers', 'Receipts go to Updates. Scams go to Spam.']} />
      <Prod icon="i-user" name="Team" claim="Work one inbox together." shot="tool-inbox" points={['Assign an email to a teammate', 'Leave a note and mention someone', 'Save the replies you send often']} />
      <Prod icon="i-globe" name="Your address" claim="Keep the address your customers know." shot="inbox-address" points={['Forward your support address to Bridle', 'Customers keep writing where they always did', 'Ten inboxes in your licence']} />
    </div></section>
    <Next3 not="inbox" />
    <Fin title="Put your inbox where your site is" />
  </div>
</Base>
