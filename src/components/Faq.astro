---
// Questions as native disclosure widgets: they work without JavaScript and
// stay readable to search engines and AI apps (FAQPage JSON-LD on the page).
import type { QA } from '../data/faq';
interface Props { items: QA[]; title?: [string, string] }
const { items, title = ['Questions', 'Asked before launch'] } = Astro.props;
---
<section class="block" id="faq" aria-labelledby="h-faq">
  <div class="faq">
    <h2 id="h-faq"><span>{title[0]}</span><span class="g">{title[1]}</span></h2>
    <div class="qa">
      {items.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
