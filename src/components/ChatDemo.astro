---
// Bridle Chat as a visitor sees it, drawn like the real bubble (the plugin's
// src/chat): an answer with its source, then a refund handed to a person.
// Played by src/scripts/chat-demo.js; the messages it adds are styled in
// site.css (.cpanel).
const icon = 'fill-none stroke-current [stroke-linecap:round] [stroke-linejoin:round] [stroke-width:2]';
---
<div class="cpanel relative isolate h-[600px] overflow-hidden rounded-card bg-brand-50 sm:h-[640px]" data-chatdemo>
  <canvas class="dots -z-10" aria-hidden="true"></canvas>
  <figure class="absolute top-7 left-4 m-0 grid h-[720px] w-[calc(100%-32px)] grid-rows-[44px_1fr] overflow-hidden rounded-card border border-border bg-card shadow-soft sm:top-[52px] lg:left-[7%] lg:w-[78%]" aria-label="A visitor asks the chat bubble on a store's site. It answers from a help page and shows the source. Asked for a refund, it hands the chat to a person and asks where to send the reply.">
    <div class="flex items-center gap-2 border-b border-border bg-secondary px-4" aria-hidden="true"><i class="size-[11px] rounded-full bg-input"></i><i class="size-[11px] rounded-full bg-input"></i><i class="size-[11px] rounded-full bg-input"></i><span class="mr-[49px] min-w-0 flex-1 truncate text-center font-mono text-[12px] text-gray">lumenslider.com/pricing</span></div>
    <div class="grid grid-cols-1 content-start gap-x-[18px] gap-y-3.5 px-5 py-7 sm:grid-cols-3 sm:px-10 sm:py-11" aria-hidden="true">
      <b class="col-span-full mb-2.5 block h-[30px] w-[52%] rounded-full bg-[#ececea]"></b>
      <i class="col-span-full block h-3 w-[78%] rounded-full bg-secondary"></i>
      <i class="col-span-full block h-3 w-[78%] rounded-full bg-secondary"></i>
      <i class="col-span-full mb-[18px] block h-3 w-[46%] rounded-full bg-secondary"></i>
      <u class="block h-[150px] rounded-card border border-border bg-[#fcfcfb]"></u>
      <u class="block h-[150px] rounded-card border border-border bg-[#fcfcfb] max-sm:hidden"></u>
      <u class="block h-[150px] rounded-card border border-border bg-[#fcfcfb] max-sm:hidden"></u>
    </div>
  </figure>
  <div class="absolute right-3 bottom-3.5 left-3 z-[2] flex flex-col items-end gap-3 text-[14.5px] leading-[1.45] sm:left-auto sm:right-[clamp(16px,5%,56px)] sm:bottom-[22px]" aria-hidden="true">
    <div class="flex h-[500px] w-full flex-col overflow-hidden rounded-[20px] bg-card shadow-[0_20px_60px_rgb(24_24_24/0.18),0_2px_8px_rgb(24_24_24/0.08),0_0_0_1px_rgb(24_24_24/0.05)] sm:h-[520px] sm:w-[360px]">
      <div class="flex items-center gap-[11px] bg-brand-600 py-3.5 pr-3.5 pl-4 text-white">
        <span class="grid size-[34px] flex-none place-items-center rounded-full bg-white/20 text-[14px] font-semibold">L</span>
        <div class="min-w-0 flex-1 leading-[1.3]"><b class="block text-[15px] font-semibold">Lumen Slider</b><small class="flex items-center gap-1.5 whitespace-nowrap text-[12px] opacity-85 before:size-[7px] before:rounded-full before:bg-[#4ade80] before:content-['']">AI assistant · a person can help</small></div>
        <svg class="size-[18px] opacity-90" viewBox="0 0 24 24"><circle cx="5.5" cy="12" r="1.3" fill="currentColor"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/><circle cx="18.5" cy="12" r="1.3" fill="currentColor"/></svg>
        <svg class:list={['size-[18px] opacity-90', icon]} viewBox="0 0 24 24"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/></svg>
      </div>
      <div class="bc-log flex flex-1 flex-col gap-2 overflow-hidden bg-card px-3.5 pt-4 pb-2.5"></div>
      <div class="bc-form gap-2 border-t border-border bg-card px-3.5 py-3"><small class="text-[13px] text-muted-foreground">Where should we send the reply?</small><span class="bc-in block h-[38px] rounded-[12px] border border-brand-600 px-[11px] py-2 shadow-[0_0_0_3px_rgb(45_111_205/0.15)]"></span><span class="bc-btn justify-self-end rounded-[12px] bg-brand-600 px-3.5 py-[7px] font-medium text-white transition-transform">Send to a person</span></div>
      <div class="bc-comp mx-3 mt-1 mb-3 flex items-center gap-1.5 rounded-[22px] border border-border py-[5px] pr-[5px] pl-3.5"><span class="min-w-0 flex-1 overflow-hidden whitespace-nowrap">Ask a question…</span><b class="grid size-8 flex-none place-items-center rounded-full bg-brand-600 text-white"><svg class:list={['size-[17px]', icon]} viewBox="0 0 24 24"><path d="M12 18.5V6M6.5 11.5 12 6l5.5 5.5"/></svg></b></div>
    </div>
    <span class="hidden size-[52px] place-items-center rounded-full bg-brand-600 text-white shadow-[0_6px_20px_rgb(24_24_24/0.16),0_1px_3px_rgb(24_24_24/0.12)] sm:grid"><svg class:list={['size-[26px]', icon]} viewBox="0 0 24 24"><path d="m6 9.5 6 6 6-6"/></svg></span>
  </div>
</div>

<script>
  import '../scripts/chat-demo.js';
</script>
