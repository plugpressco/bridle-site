---
// A plan's features, all drawn the same way: an icon, a short name, one line.
import type { Feature } from '../data/site';
interface Props { items: Feature[]; tone?: 'blue' | 'plain'; cols?: number }
const { items, tone = 'plain', cols = 3 } = Astro.props;
---
<ul class="grid grid-cols-1 gap-x-8 gap-y-7 min-[481px]:grid-cols-2 min-[861px]:grid-cols-[repeat(var(--cols),minmax(0,1fr))] min-[861px]:gap-y-9" style={`--cols:${cols}`}>
  {items.map((f) => (
    <li class="min-w-0">
      <span class:list={['mb-4 grid size-10 place-items-center rounded-card', tone === 'blue' ? 'bg-brand-100 text-brand-600' : 'border border-border bg-card text-foreground']}><svg class="i size-[19px]" aria-hidden="true"><use href={`#${f.icon}`} /></svg></span>
      <h3 class="mb-1 text-[18px] font-medium">{f.name}</h3>
      <p class="text-[16px] leading-normal text-muted-foreground">{f.text}</p>
    </li>
  ))}
</ul>
