---
// A section of an inner page. Plain on the page, or `tone="tint"` for the
// site's one section panel (white, hairline, 12 px), the same as the home page. 72 px apart on phones, 120 px on desktop; `pad="top"` for
// a page's opening.
import Container from './Container.astro';
interface Props { id?: string; tone?: 'white' | 'tint'; labelledby?: string; label?: string; pad?: 'section' | 'top'; class?: string; inner?: string }
const { id, tone = 'white', labelledby, label, pad = 'section', class: cls, inner } = Astro.props;
---
<section id={id} aria-labelledby={labelledby} aria-label={label} class={cls}>
  <Container class:list={[pad === 'top' ? 'pt-14 pb-12 md:pt-24 md:pb-16' : 'py-9 md:py-[60px]']}>
    <div class:list={[tone === 'tint' && 'rounded-panel border border-border bg-card px-6 py-12 md:px-20 md:py-24', inner]}><slot /></div>
  </Container>
</section>
