---
// A section of an inner page: open on the page like the home page's, lined up
// to the one container. Space does the separating: 96 px apart on desktop,
// 64 on phones. `tone` is kept for old callers and draws nothing. `pad="top"` for
// a page's opening.
import Container from './Container.astro';
interface Props { id?: string; tone?: 'white' | 'tint'; labelledby?: string; label?: string; pad?: 'section' | 'top'; class?: string; inner?: string }
const { id, tone = 'white', labelledby, label, pad = 'section', class: cls, inner } = Astro.props;
---
<section id={id} aria-labelledby={labelledby} aria-label={label} class={cls}>
  <Container class:list={[pad === 'top' ? 'pt-10 pb-8 md:pt-16 md:pb-12' : 'py-8 md:py-12']}>
    <div class:list={[inner]}><slot /></div>
  </Container>
</section>
