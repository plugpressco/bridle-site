---
// Questions: the title row, then every answer open in two columns (owner,
// 2026-11-10: the box with closed rows looked "worried"; the answers are one
// or two short lines, so nothing needs a click). Plain on the page by default,
// so the sections around it keep their own colours. FAQPage JSON-LD on the
// page carries the same text. A question with an id can be linked to.
import type { QA } from '../../data/faq';
import { SITE } from '../../data/site';
interface Props { items: QA[]; title: string; id?: string; tone?: string }
const { items, title, id = 'faq', tone = 'plain' } = Astro.props;
---
<section class:list={['band', tone]} id={id} aria-labelledby={`h-${id}`}>
  <div class="faqhead">
    <h2 class="h2" id={`h-${id}`}>{title}</h2>
    <p class="sub">Can’t find yours? <a class="lnk text-[length:inherit]" href={SITE.support}>Ask us.</a></p>
  </div>
  <dl class="qa">
    {items.map((f) => <div id={f.id}><dt>{f.q}</dt><dd>{f.a}</dd></div>)}
  </dl>
</section>
