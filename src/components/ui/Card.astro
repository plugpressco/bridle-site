---
// The one card: white, one hairline, small corners. `lift` adds the one soft
// shadow, for a card that stands over something.
interface Props { class?: string; lift?: boolean; [attr: string]: unknown }
const { class: cls, lift = false, ...attrs } = Astro.props;
---
<div class:list={['min-w-0 rounded-card border border-border bg-card p-6 md:p-8', lift && 'shadow-soft', cls]} {...attrs}><slot /></div>
