---
// A heading in two tones (design v3): the first sentence in navy, the second
// in soft grey, both Geist 500 with tight tracking. An optional kicker above
// and a lead under it, with the same gaps everywhere.
interface Props {
  id?: string;
  as?: 'h1' | 'h2';
  first: string;
  second?: string;
  eyebrow?: string;
  lead?: string;
  size?: 'display' | 'title' | 'section';
  class?: string;
  [attr: string]: unknown;
}
const { id, as: Tag = 'h2', first, second, eyebrow, lead, size = 'section', class: cls, ...attrs } = Astro.props;
const sizes = { display: 'h1', title: 'h1x', section: 'h2' };
// Two sentences run on in one line ("Free to use. Pay once for Pro.");
// two short phrases without full stops sit on two lines.
const inline = /[.?!]$/.test(first);
---
<div class:list={['grid content-start gap-4', cls]}>
  {eyebrow && <p class="kicker [&_a]:no-underline [&_a]:text-muted-foreground [&_a:hover]:text-foreground" set:html={eyebrow} />}
  <Tag id={id} class={sizes[size]} {...attrs}>{first}{second && (inline ? <> <span class="soft">{second}</span></> : <span class="soft block">{second}</span>)}</Tag>
  {lead && <p class="lead text-ink-2">{lead}</p>}
</div>
