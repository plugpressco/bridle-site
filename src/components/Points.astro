---
// Three short points side by side, in columns with gaps: a number or an icon,
// a name and one line.
interface Props { items: { title: string; text: string; icon?: string }[]; numbered?: boolean }
const { items, numbered = false } = Astro.props;
---
<ol class="grid gap-10 md:grid-cols-3 md:gap-8">
  {items.map((p, i) => (
    <li class="min-w-0">
      {numbered
        ? <span class="mb-4 block font-mono text-[13px] font-medium text-brand-600">0{i + 1}</span>
        : p.icon && <span class="mb-5 grid size-10 place-items-center rounded-card border border-border bg-card"><svg class="i size-[19px]" aria-hidden="true"><use href={`#${p.icon}`} /></svg></span>}
      <h3 class="mb-2 text-[21px] font-medium tracking-[-0.01em]">{p.title}</h3>
      <p class="max-w-[26em] text-[16.5px] leading-normal text-muted-foreground">{p.text}</p>
    </li>
  ))}
</ol>
