---
// Pricing: what Pro adds. One icon, a short name and one line each (owner,
// 2026-11-11: "make cleaner simple"). Facts from bridle-pro/README.md; store
// names and plan numbers are in the compare table below.
import { PRO, count } from '../../data/site';
const answers = PRO.plans.map((p) => count(p.answers));
const items = [
  { icon: 'i-globe', name: 'Chat on other sites', text: 'Paste one line on any site. Chats come to this inbox.' },
  { icon: 'i-live', name: 'Live chat', text: 'Jump in while they are still there. Set your hours.' },
  { icon: 'i-bag', name: 'Orders and licences', text: 'Replies can say where an order is or if a licence is active.' },
  { icon: 'i-help', name: 'Missing answers', text: 'Turn a question it couldn’t answer into a doc.' },
  { icon: 'i-history', name: 'Workflows', text: 'A nudge when someone waits. Quiet chats close by themselves.' },
  { icon: 'i-sparkles', name: 'AI answers included', text: `${answers[0]}, ${answers[1]} or ${answers[2]} with your plan.` },
];
---
<section class="band" aria-labelledby="h-adds">
  <h2 class="h2 opener" id="h-adds">What Pro adds.</h2>
  <ul class="feats">
    {items.map((i) => (
      <li>
        <span class="fi"><svg class="i" aria-hidden="true"><use href={`#${i.icon}`} /></svg></span>
        <h3>{i.name}</h3>
        <p>{i.text}</p>
      </li>
    ))}
  </ul>
</section>
