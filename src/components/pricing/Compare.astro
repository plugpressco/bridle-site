---
// Pricing 5, compare plans (pricing/08-copy.md §5). Every row true to the
// plugin's AGENTS.md and bridle-pro/README.md; support cells confirmed by the
// owner on 10 November 2026.
import { AI, PRO, INBOXES, WPORG_LIVE, money, count } from '../../data/site';
const Y = '✓';
// One short list, no groups (owner, 2026-11-11: "simpler"). Free rows first,
// then what Pro adds.
const rows: [string, string, string][] = [
  ['Inboxes on the Bridle mail service', `${INBOXES.free} per site`, '10, 25 or unlimited'],
  ['Email: sorting, drafts, fact checks, Auto, rewrite', Y, Y],
  ['Chat bubble on this site', Y, Y],
  ['Help docs (Bridle KB, free plugin)', Y, Y],
  ['AI apps (Claude, ChatGPT) over MCP', Y, Y],
  ['Teammates and your own AI key', 'No limit', 'No limit'],
  ['Bridle AI answers', `${AI.free} free a month`, `${count(PRO.plans[0].answers)} to ${count(PRO.plans[PRO.plans.length - 1].answers)} included`],
  ['Chat on your other sites', '', Y],
  ['Live chat and business hours', '', Y],
  ['Order and licence lookups', 'WooCommerce card', 'Every order, plus EDD, Polar, Freemius'],
  ['Missing answers, with “write a doc”', '', Y],
  ['Late-reply nudges, auto-resolve, share new mail', '', Y],
  ['Updates and support', WPORG_LIVE ? 'WordPress.org' : 'Free, help desk', 'For life, help desk'],
  ['Price', '$0', `${PRO.plans.map((p) => money(p.base)).join(', ').replace(/, ([^,]*)$/, ' or $1')}, once`],
];
---
<section class="band" aria-labelledby="h-compare">
  <div class="opener"><h2 class="h2" id="h-compare">Compare plans.</h2><p class="sub">Everything that answers your customers is free.</p></div>
  <div class="tbl"><table>
    <thead><tr><th scope="col">Feature</th><th scope="col">Bridle</th><th scope="col">Bridle Pro</th></tr></thead>
    <tbody>
      {rows.map((r) => <tr><th scope="row" class="!font-normal !text-ink-2">{r[0]}</th>{r.slice(1).map((c) => c === Y ? <td class="y"><span aria-hidden="true">{Y}</span><span class="sr-only">Yes</span></td> : <td>{c || <span class="sr-only">No</span>}</td>)}</tr>)}
    </tbody>
  </table></div>
</section>
