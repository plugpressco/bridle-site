---
// The plans (owner, 2026-11-11: "make 3 plan, remove free one", then "make
// pricing table professional"): Pro for 1, 3 and 10 sites as three equal
// columns in one box, each with its price, one button and only what differs;
// then everything every plan includes, listed once. Prices, inboxes and AI
// answers come from src/data (deal.json, site.ts). "Next price" is the price
// after the next 20 sales. Buttons follow the launch switch.
import Button from '../ui/Button.astro';
import SecHead from '../ui/SecHead.astro';
import { AI, PRO, LAUNCHED, money, count, sitesLabel } from '../../data/site';
interface Props { id?: string; title?: string }
const { id = 'plans', title = 'Pay once. Keep it for life.' } = Astro.props;
const best = '3';
const blurb: Record<string, string> = { '1': 'For one shop or plugin site.', '3': 'For a few sites. The lowest price per site.', '10': 'For agencies and many sites.' };
const includes = [
  'Chat on all your sites',
  'Live chat and business hours',
  'Order and licence lookups: WooCommerce, EDD, Polar, Freemius',
  'Missing answers, with “write a doc”',
  'Late-reply nudges and auto-resolve',
  'Reply drafts, fact checks and Auto',
  'No limit on teammates or your own AI key',
  'Updates and support for life',
];
const check = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10.5l3.2 3.2L15 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<section class="band" id={id} aria-labelledby={`h-${id}`}>
  <SecHead id={id} title={title} line={`Black Friday price until Cyber Monday. Then Pro is yearly, and the price goes up ${money(PRO.rise)} every 20 sales.`} />
  <div class="plans3">
    {PRO.plans.map((p) => (
      <div class:list={['p3', p.key === best && 'best']}>
        <div class="p3head"><h3>Pro · {sitesLabel(p.sites)}</h3>{p.key === best && <span class="p3pill">Best value</span>}</div>
        <p class="p3blurb">{blurb[p.key]}</p>
        <div class="p3price"><b>{money(p.base)}</b><span>pay once</span></div>
        <p class="p3next">Next price {money(p.base + PRO.rise)}</p>
        <Button variant={p.key === best ? 'primary' : 'line'} href={LAUNCHED ? `/api/checkout?plan=${p.key}` : '#join'}>{LAUNCHED ? `Get Pro for ${sitesLabel(p.sites)}` : 'Join the waitlist'}</Button>
        <ul class="p3list">
          <li><Fragment set:html={check} /><span><b>{sitesLabel(p.sites)}</b></span></li>
          <li><Fragment set:html={check} /><span><b>{p.inboxes == null ? 'Unlimited' : p.inboxes}</b> inboxes</span></li>
          <li><Fragment set:html={check} /><span><b>{count(p.answers)}</b> Bridle AI answers</span></li>
        </ul>
      </div>
    ))}
  </div>
  <div class="incl">
    <h3>Every plan includes</h3>
    <ul>{includes.map((i) => <li><Fragment set:html={check} />{i}</li>)}</ul>
    <p class="small">{PRO.refundDays}-day refund. No subscription during the deal. More AI answers: {money(AI.packs[0].price)} for {count(AI.packs[0].answers)}, and packs never run out.</p>
  </div>
</section>
