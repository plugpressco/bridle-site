---
// A legal page from its data (src/data/legal.ts): contents on the left, the
// text on the right. The Markdown copy renders from the same data.
import type { Doc } from '../data/legal';
import { SITE } from '../data/site';
interface Props { doc: Doc }
const { doc } = Astro.props;
---
<div class="wrap legal">
  <nav class="toc" aria-label="On this page">
    <b>On this page</b>
    {doc.parts.map((p) => <a href={`#${p.id}`}>{p.title}</a>)}
  </nav>
  <article class="prose">
    <h1><span>{doc.title[0]}</span><span class="g">{doc.title[1]}</span></h1>
    <p class="lead">{doc.lead}</p>
    <p class="fine">Last updated {SITE.updated}.</p>
    {doc.parts.map((p) => (
      <section id={p.id}>
        <h2>{p.title}</h2>
        {p.body.map((b) =>
          typeof b === 'string' ? <p>{b}</p>
          : 'list' in b ? <ul>{b.list.map((l) => <li>{l}</li>)}</ul>
          : <table><thead><tr>{b.table[0].map((c) => <th scope="col">{c}</th>)}</tr></thead><tbody>{b.table.slice(1).map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody></table>
        )}
      </section>
    ))}
  </article>
</div>
