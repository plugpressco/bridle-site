---
// A legal page from its data (src/data/legal.ts), easy to read (owner,
// 2026-11-11): one 680 px column, an "In short" box, a contents list, then
// short parts. The Markdown copy renders from the same data.
import Section from './ui/Section.astro';
import HeadingPair from './ui/HeadingPair.astro';
import type { Doc } from '../data/legal';
import { SITE } from '../data/site';
interface Props { doc: Doc }
const { doc } = Astro.props;
---
<Section pad="top" inner="mx-auto max-w-[680px]">
  <article class="prose doc">
    <HeadingPair as="h1" size="title" first={doc.title[0]} second={doc.title[1]} lead={doc.lead} />
    <p class="!mt-3.5 !text-[15px] !text-gray">Last updated {SITE.updated}.</p>
    <aside class="short" aria-labelledby="h-short">
      <h2 id="h-short">In short</h2>
      <ul>{doc.summary.map((l) => <li>{l}</li>)}</ul>
    </aside>
    <nav class="toc" aria-labelledby="h-toc">
      <h2 id="h-toc">Contents</h2>
      <ol>{doc.parts.map((p) => <li><a href={`#${p.id}`}>{p.title}</a></li>)}</ol>
    </nav>
    {doc.parts.map((p) => (
      <section id={p.id}>
        <h2>{p.title}</h2>
        {p.body.map((b) =>
          typeof b === 'string' ? <p>{b}</p>
          : 'h' in b ? <h3>{b.h}</h3>
          : 'list' in b ? <ul>{b.list.map((l) => <li>{l}</li>)}</ul>
          : <div class="tbl-wrap"><table><thead><tr>{b.table[0].map((c) => <th scope="col">{c}</th>)}</tr></thead><tbody>{b.table.slice(1).map((r) => <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>)}</tbody></table></div>
        )}
      </section>
    ))}
  </article>
</Section>
