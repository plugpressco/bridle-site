---
// A feature page's opening: the home page's hero shape, the copy on the left
// and one real Bridle screen on the panel at the right, running off its edge.
import Button from '../ui/Button.astro';
import Shot from '../Shot.astro';
import Dither from '../Dither.astro';
import { LAUNCHED, FREE_URL } from '../../data/site';
interface Props { title: [string, string]; lead: string; shot: { name: string; width: number; height: number; alt: string }; center?: boolean }
const { title, lead, shot, center = false } = Astro.props;
const main = LAUNCHED ? { href: FREE_URL, label: 'Get Bridle free' } : { href: '#join', label: 'Join the waitlist' };
---
<section class="hero" aria-labelledby="h-page">
  <div class="copy">
    <h1 class="h1" id="h-page">{title[0]} <span class="soft">{title[1]}</span></h1>
    <p class="lead">{lead}</p>
    <div class="ctas"><Button size="lg" arrow href={main.href}>{main.label}</Button><Button size="lg" variant="soft" href="/demo/">Try the live demo</Button></div>
  </div>
  <div class="panel hero-pic">
    <Dither />
    <div class:list={['hero-shot', center && 'center']}><Shot name={shot.name} width={shot.width} height={shot.height} alt={shot.alt} eager /></div>
  </div>
</section>
