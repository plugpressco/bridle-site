---
// The one Pro line on a feature page: a heading, one line, one button.
import Button from '../ui/Button.astro';
interface Props { title: string; text: string }
const { title, text } = Astro.props;
---
<section class="band" aria-label="Bridle Pro">
  <div class="grid items-center gap-8 md:grid-cols-[minmax(0,1fr)_auto]">
    <div class="grid gap-4">
      <h2 class="h2">{title}</h2>
      <p class="lead text-ink-2">{text}</p>
    </div>
    <Button href="/pricing/" arrow>See pricing</Button>
  </div>
</section>
