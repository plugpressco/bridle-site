---
// Tall cards that explain one part each (owner, 2026-11-11: "see how deeply
// they explain their product"): a bold name, two or three plain sentences,
// and a piece of Bridle's own UI at the bottom rising from the dot cloud.
import Dither from '../Dither.astro';
export interface StoryCard { title: string; text: string; ui: string }
interface Props { cards: StoryCard[]; title?: string; id?: string; more?: boolean }
const { cards, title, id, more = false } = Astro.props;
---
<section class:list={['band', more && 'story-more']} id={id} aria-labelledby={title && id ? `h-${id}` : undefined} aria-label={title ? undefined : 'How it works'}>
  {title && <h2 class="h2 opener" id={`h-${id}`}>{title}</h2>}
  <ul class="story">
    {cards.map((c) => (
      <li>
        <h3>{c.title}</h3>
        <p>{c.text}</p>
        <div class="sui" aria-hidden="true"><Dither /><div class="smock"><Fragment set:html={c.ui} /></div></div>
      </li>
    ))}
  </ul>
</section>
