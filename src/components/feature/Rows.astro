---
// Big screen rows (owner, 2026-11-11, picked "big screen rows"): each part of
// Bridle gets a wide row, short text on one side and a big real Bridle screen
// on a soft panel with the dot cloud on the other. Sides alternate.
import Shot from '../Shot.astro';
import Dither from '../Dither.astro';
export interface Row { id: string; title: string; text: string; points?: string[]; shot?: { name: string; width: number; height: number; alt: string }; center?: boolean; bottom?: boolean; ui?: string }
interface Props { rows: Row[] }
const { rows } = Astro.props;
---
{rows.map((r, i) => (
  <section class:list={['band rrow', i % 2 === 1 && 'flip']} id={r.id} aria-labelledby={`h-${r.id}`}>
    <div class="rtext">
      <h2 class="h2" id={`h-${r.id}`}>{r.title}</h2>
      <p>{r.text}</p>
      {r.points && <ul>{r.points.map((p) => <li>{p}</li>)}</ul>}
    </div>
    <div class:list={['rpanel', (r.center || r.ui) && 'center', r.bottom && 'bottom']}>
      <Dither from={i % 2 === 1 ? 'bottom' : 'right'} />
      {r.shot && <div class="rshot"><Shot name={r.shot.name} width={r.shot.width} height={r.shot.height} alt={r.shot.alt} /></div>}
      {r.ui && <div class="rshot rui" aria-hidden="true"><Fragment set:html={r.ui} /></div>}
    </div>
  </section>
))}
