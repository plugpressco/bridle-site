---
// The home page's "what it does" shape: the section heading, one big real
// screen on the panel, then three or four points (a name and one line).
import Shot from '../Shot.astro';
import Dither from '../Dither.astro';
interface Props { id: string; title: string; sub: string; shot?: { name: string; width: number; height: number; alt: string }; points: { name: string; text: string }[] }
const { id, title, sub, shot, points } = Astro.props;
---
<section class="band" id={id} aria-labelledby={`h-${id}`}>
  <div class="opener"><h2 class="h2" id={`h-${id}`}>{title}</h2><p class="sub">{sub}</p></div>
  {shot ? <div class="panel big"><Dither /><Shot name={shot.name} width={shot.width} height={shot.height} alt={shot.alt} /></div> : <slot />}
  <div class:list={['flist', points.length === 4 ? 'four' : 'three']}>
    {points.map((p) => <div><h3>{p.name}</h3><p>{p.text}</p></div>)}
  </div>
</section>
