---
// One block of a feature page (owner, 2026-11-11, after helpscout.com/copilot
// and /inbox: "how nicely present"). Bridle's own take: the outcome as the
// heading, one short line, one big real screen on a soft panel with the dot
// cloud, then two or three points (icon, name, one line). Value first, the
// feature name only in the points.
import Shot from '../Shot.astro';
import Dither from '../Dither.astro';
interface Item { icon: string; name: string; text: string }
interface Props {
  id: string;
  title: string;
  sub?: string;
  tag?: string;
  shot?: { name: string; width: number; height: number; alt: string };
  items?: Item[];
  link?: { href: string; label: string };
  statement?: boolean;
}
const { id, title, sub, tag, shot, items = [], link, statement = false } = Astro.props;
// No screen: points sit in a white card beside the heading (split); a slot is
// drawn in the same place. Nothing at all: a centred statement on a soft band.
const hasSlot = Astro.slots.has('default');
const split = !shot && (items.length > 0 || hasSlot);
---
<section class:list={['band fblock', split && 'fsplit', statement && 'fstate t-sky']} id={id} aria-labelledby={`h-${id}`}>
  <div class="opener">
    {tag && <p class="ftag">{tag}</p>}
    <h2 class="h2" id={`h-${id}`}>{title}</h2>
    {sub && <p class="sub">{sub}</p>}
    {link && <p class="mt-4"><a class="lnk" href={link.href}>{link.label} ›</a></p>}
  </div>
  {shot && <div class="panel big fpanel"><Dither /><Shot name={shot.name} width={shot.width} height={shot.height} alt={shot.alt} /></div>}
  {hasSlot && <div class="fside"><slot /></div>}
  {items.length > 0 && (
    <ul class:list={['fpoints', split && 'fcard', items.length === 2 && 'two-up']}>
      {items.map((i) => (
        <li>
          <span class="fi"><svg class="i" aria-hidden="true"><use href={`#${i.icon}`} /></svg></span>
          <div><h3>{i.name}</h3><p>{i.text}</p></div>
        </li>
      ))}
    </ul>
  )}
</section>
