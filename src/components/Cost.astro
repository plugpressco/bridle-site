---
// 4 Cost (home 08-copy.md §4, pricing §6): what 2 people pay a month, with one
// slider for AI answers (src/scripts/cost.js). The numbers come from
// src/data/cost.ts; the first paint is already right for 300 answers.
import { RIVALS, PEOPLE, CHECKED, monthly, money } from '../data/cost';
import { AI } from '../data/site';
interface Props { id: string; counted?: boolean; tone?: string }
const { id, counted = false, tone = 'white' } = Astro.props;
const N = 300;
const c = monthly(N);
const max = Math.max(...Object.values(c));
const width = (v: number) => `${((v / max) * 100).toFixed(2)}%`;
const rows = [{ key: 'bridle', label: 'Bridle, Bridle AI', me: true }, ...RIVALS.map((r) => ({ key: r.key, label: `${r.name} ${r.plan}`, me: false }))];
const data = JSON.stringify({ free: AI.free, per: AI.packs[0].price / AI.packs[0].answers, people: PEOPLE, rivals: RIVALS.map(({ key, seat, perAnswer, included }) => ({ key, seat, perAnswer, included })) });
const first = RIVALS[0];
---
<section class:list={['band', tone]} aria-labelledby={`h-${id}`} id={id}>
  <div class="cost" data-cost={data}>
    <div>
      <h2 class="h2" id={`h-${id}`}>About a cent an answer.</h2><p class="sub">Or free with your own AI key.</p>
      <p class="b">Other help desks charge up to $2 each time their AI answers, plus a price per person.</p>
      <div class="slider"><label for={`n-${id}`}><span>AI answers a month</span><output class="tab" data-out="n" for={`n-${id}`}>{N}</output></label><input type="range" id={`n-${id}`} min="100" max="5000" step="100" value={N} /></div>
    </div>
    <div class="board">
      <div class="totals"><div class="me"><b data-out="bridle">{money(c.bridle)}</b><span class="small">Bridle, with Bridle AI, a month</span></div><div><b data-out={first.key}>{money(c[first.key])}</b><span class="small">{first.name} for {PEOPLE} people, a month</span></div></div>
      <div class="bars">
        {rows.map((r) => <div class:list={[r.me && 'me']}><span>{r.label}</span><i data-bar={r.key} style={`width:${width(c[r.key])}`}></i><span data-out={r.key}>{money(c[r.key])}</span></div>)}
      </div>
      <p class="small">{PEOPLE} people, billed yearly. Prices checked {CHECKED}.{!counted && <> <a class="lnk text-[length:inherit]" href="/pricing/#how">How we counted</a></>}</p>
    </div>
  </div>
  {counted && <p class="counted"><b class="font-medium text-foreground">How we counted.</b> Two people, billed yearly, on these plans: Help Scout Standard ($25 a person, $0.75 per AI answer), Intercom Essential ($29 a person, $0.99 per AI answer), Zendesk Suite Team ($55 a person, $1.50 to $2.00 per AI answer). Bridle counts one Bridle AI answer as $0.01 after the 100 free each month. Checked on {CHECKED}.</p>}
</section>

<script>
  import '../scripts/cost.js';
</script>
