---
// The menu: a plain full-width bar that gets a hairline once you scroll.
// Product opens a panel under it: the four tools on the left and, on the
// right, a picture of the tool you point at. Resources is a short plain list.
// The right side holds the account link and the price; the buy button
// joins them once the hero's own buttons have scrolled away, so nothing is
// said twice in the first screen (owner, 2026-11-11). On phones a Menu button
// opens a full-height sheet. Esc closes; focus stays inside (src/scripts/nav.js).
import Mark from './Brand.astro';
import Shot from './b/Shot.astro';
import { TOOLS, type ToolKey } from './b/tools';
import { SITE, ACCOUNT_URL, OFFER_ON, PRICE, DEAL, money } from '../data/site';
const path = Astro.url.pathname;
const keys = Object.keys(TOOLS) as ToolKey[];
const previews: Record<ToolKey, string> = { inbox: 'tool-inbox', ai: 'tool-ai', chat: 'tool-chat', docs: 'tool-docs' };
const resources = [
  [
    { label: 'Guides', text: 'Set up each part, step by step', href: '/guides/' },
    { label: 'Help docs', text: 'Every setting, explained', href: SITE.docs },
    { label: 'Live demo', text: 'Try Bridle in your browser', href: '/demo/' },
    { label: 'Bridle and Help Scout', text: 'The two, side by side', href: '/compare/help-scout/' },
  ],
  [
    { label: 'About PlugPress', text: 'The team behind Saddle and Mailpuff', href: SITE.companyUrl },
    { label: 'Support', text: 'Ask us. A person answers.', href: SITE.support },
    { label: 'Account', text: 'Your licence key and downloads', href: ACCOUNT_URL },
  ],
];
const down = '<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9.5 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<header class="navwrap">
  <nav class="cap" id="cap" aria-label="Main">
    <div class="bar">
      <Mark />
      <div class="links">
        <button type="button" class="trig" id="t-product" aria-expanded="false" aria-controls="m-product">Product <Fragment set:html={down} /></button>
        <a href="/pricing/" aria-current={path.startsWith('/pricing/') ? 'page' : undefined}>Pricing</a>
        <button type="button" class="trig" id="t-resources" aria-expanded="false" aria-controls="m-resources">Resources <Fragment set:html={down} /></button>
      </div>
      <div class="navright">
        <a class="navlink" href={ACCOUNT_URL}>Account</a>
        <a class="navnote" href="/pricing/"><span class="navwords" data-deal="tag">{OFFER_ON ? 'Black Friday' : 'Price'}</span> <b><span data-deal="price">{money(PRICE)}</span> once</b></a>
        <div class="acts navbuy"><a class="b1 sm" href="/pricing/">Buy Bridle</a></div>
      </div>
      <button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="sheet">Menu</button>
    </div>
    <div class="drop" id="drop"><div class="drop-in">
      <div class="mpanel" id="m-product" hidden>
        <div class="mprod">
          <div class="mlist">
            {keys.map((k, n) => <a class:list={['mitem', n === 0 && 'on']} href={TOOLS[k].href} data-prev={k}><b>{TOOLS[k].name}</b><span>{TOOLS[k].line}</span></a>)}
            <div class="mfoot"><a href="/demo/">Try the live demo</a><a href="/pricing/">Pricing</a></div>
          </div>
          <div class="mprev" aria-hidden="true">
            {keys.map((k, n) => <figure class:list={[n === 0 && 'on']} data-pane={k}><Shot name={previews[k] as any} alt="" /></figure>)}
          </div>
        </div>
      </div>
      <div class="mpanel" id="m-resources" hidden>
        <div class="mres">
          <div><h4>Learn</h4>{resources[0].map((i) => <a class="mitem" href={i.href}><b>{i.label}</b><span>{i.text}</span></a>)}</div>
          <div><h4>Company</h4>{resources[1].map((i) => <a class="mitem" href={i.href}><b>{i.label}</b><span>{i.text}</span></a>)}</div>
        </div>
      </div>
    </div></div>
  </nav>
</header>
<div class="dim" id="dim" hidden></div>

<div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="sheet-top"><Mark /><button type="button" class="close-btn" id="sheet-close">Close</button></div>
  <div><h4>Product</h4>{keys.map((k) => <a class="mitem" href={TOOLS[k].href}><b>{TOOLS[k].name}</b><span>{TOOLS[k].line}</span></a>)}</div>
  <div><h4>Pricing</h4><a class="mitem" href="/pricing/"><b>One licence</b><span>{OFFER_ON ? `Pay once. ${money(PRICE)} until ${DEAL.endsLabel}.` : `Pay once. ${money(PRICE)}.`}</span></a></div>
  <div><h4>Resources</h4>{resources.flat().map((i) => <a class="mitem" href={i.href}><b>{i.label}</b><span>{i.text}</span></a>)}</div>
  <div class="grid gap-2.5">
    <a class="b1" href="/pricing/">Buy Bridle</a>
    <a class="b2" href="/demo/">Try the live demo</a>
  </div>
</div>

<script>
  import '../scripts/nav.js';
  import '../scripts/deal.js';
</script>
