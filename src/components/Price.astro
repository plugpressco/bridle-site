---
// Bridle Pro's Black Friday deal: a calm countdown, the step line, and the
// three licences side by side (3 sites is our pick). The first paint shows
// step 1 from deal.json; src/scripts/deal.js swaps in the live prices from
// /api/deal once Polar answers (never a made-up number) and keeps the
// countdown in days and hours. The buttons join the waitlist until
// CHECKOUT_OPEN (src/data/site.ts) is true, then open a Polar checkout.
import { PRO, CHECKOUT_OPEN, money, count, sitesLabel } from '../data/site';
const first = PRO.first;
---
<div class="deal" data-deal data-open={CHECKOUT_OPEN ? '1' : undefined} data-ends={PRO.endsAt}>
  <div class="deal-top">
    <p class="deal-ends"><svg class="i" aria-hidden="true"><use href="#i-clock" /></svg><span data-deal-ends>Black Friday deal. Ends {PRO.endsLabel}.</span></p>
    <p class="deal-line"><b data-deal-left>First {first.to} sales at these prices.</b> <span data-deal-next>Then +{money(PRO.rise)}.</span></p>
  </div>
  <div class="plans3">
    {PRO.plans.map((p, i) => (
      <div class:list={['card', 'plan', { pick: i === 1 }]} data-plan={p.key}>
        <div class="plan-head">
          <h3>{sitesLabel(p.sites)}</h3>
          {i === 1 && <span class="pick-tag">Our pick</span>}
        </div>
        <p class="amount"><b data-plan-price>{money(p.base)}</b></p>
        <p class="once">Pay once</p>
        <ul class="ticks">
          <li><svg class="i"><use href="#i-check" /></svg>Updates and support for life</li>
          <li><svg class="i"><use href="#i-check" /></svg>Use it on {sitesLabel(p.sites)}</li>
          <li><svg class="i"><use href="#i-check" /></svg>{count(p.answers)} AI answers</li>
        </ul>
        {CHECKOUT_OPEN
          ? <a class:list={['btn', { ghost: i !== 1 }]} href={`/api/checkout?plan=${p.key}`} data-plan-buy>Get it for {money(p.base)}</a>
          : <a class:list={['btn', { ghost: i !== 1 }]} href="#join">Join the waitlist</a>}
      </div>
    ))}
  </div>
</div>

<script>
  import '../scripts/deal.js';
</script>
