---
// Bridle Pro's three licences, side by side, with the step line once above
// them. The first paint shows step 1 from deal.json; src/scripts/deal.js
// swaps in the live prices from /api/deal once Polar answers (never a
// made-up number). The buttons join the waitlist until CHECKOUT_OPEN
// (src/data/site.ts) is true, then open a Polar checkout for that plan.
import { PRO, AI, CHECKOUT_OPEN, money, count, sitesLabel } from '../data/site';
const first = PRO.first;
---
<div class="deal" data-deal data-open={CHECKOUT_OPEN ? '1' : undefined}>
  <p class="deal-line"><b data-deal-left>First {first.to} sales at these prices.</b> <span data-deal-next>Then +{money(PRO.rise)}.</span></p>
  <div class="plans3">
    {PRO.plans.map((p, i) => (
      <div class:list={['card', 'plan', { dark: i === 1 }]} data-plan={p.key}>
        <h3>{sitesLabel(p.sites)}</h3>
        <p class="amount"><b data-plan-price>{money(p.base)}</b><span>pay once</span></p>
        <ul class="ticks">
          <li><svg class="i"><use href="#i-check" /></svg>{count(p.answers)} AI answers</li>
          <li><svg class="i"><use href="#i-check" /></svg>Every Pro feature</li>
        </ul>
        {CHECKOUT_OPEN
          ? <a class:list={['btn', { ghost: i !== 1 }]} href={`/api/checkout?plan=${p.key}`} data-plan-buy>Get it for {money(p.base)}</a>
          : <a class:list={['btn', { ghost: i !== 1 }]} href="#join">Join the waitlist</a>}
      </div>
    ))}
  </div>
  <p class="fine">AI answers run out? Top up from {money(AI.topUpFrom)}. {PRO.refundDays}-day refund.</p>
</div>

<script>
  import '../scripts/deal.js';
</script>
