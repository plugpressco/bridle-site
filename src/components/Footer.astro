---
// The footer: the mark and the fine print, then four short columns of plain
// links, on white.
import Mark from './Brand.astro';
import { SITE } from '../data/site';
const year = new Date().getFullYear();
const cols = [
  { title: 'Product', links: [
    { href: '/inbox/', label: 'Inbox' },
    { href: '/ai-answers/', label: 'AI answers' },
    { href: '/chat/', label: 'Chat' },
    { href: '/docs/', label: 'Docs' },
    { href: '/pricing/', label: 'Pricing' },
  ] },
  { title: 'Resources', links: [
    { href: '/demo/', label: 'Live demo' },
    { href: '/guides/', label: 'Guides' },
    { href: SITE.docs, label: 'Help docs' },
    { href: '/compare/help-scout/', label: 'Bridle and Help Scout' },
    { href: '/llms.txt', label: 'llms.txt' },
  ] },
  { title: 'Company', links: [
    { href: SITE.companyUrl, label: 'PlugPress' },
    { href: SITE.saddle, label: 'Saddle' },
    { href: SITE.support, label: 'Support' },
  ] },
  { title: 'Legal', links: [
    { href: '/privacy/', label: 'Privacy' },
    { href: '/terms/', label: 'Terms' },
    { href: '/terms/#refunds', label: 'Refunds' },
  ] },
];
---
<footer class="foot">
  <div class="wrap">
    <div><Mark /><p class="small mt-2.5">© {year} {SITE.company}</p></div>
    {cols.map((c) => (
      <nav aria-label={c.title}>
        <h2>{c.title}</h2>
        {c.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    ))}
  </div>
</footer>
