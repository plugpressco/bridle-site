---
// The footer: what Bridle is in one line, three short columns, the fine
// print. The end of the page takes the one soft tint; the rails run through.
import Brand from './Brand.astro';
import Container from './ui/Container.astro';
import { SITE } from '../data/site';
const year = new Date().getFullYear();
const cols = [
  { title: 'Product', links: [
    { href: '/#how', label: 'How it works' },
    { href: '/chat/', label: 'Bridle Chat' },
    { href: '/#agents', label: 'AI apps' },
    { href: '/demo/', label: 'Live demo' },
    { href: '/pro/', label: 'Bridle Pro' },
    { href: '/guides/', label: 'Guides' },
  ] },
  { title: 'Legal', links: [
    { href: '/privacy/', label: 'Privacy' },
    { href: '/privacy/#relay', label: 'Email relay' },
    { href: '/privacy/#processors', label: 'Sub-processors' },
    { href: '/terms/', label: 'Terms' },
  ] },
  { title: 'Company', links: [
    { href: SITE.companyUrl, label: 'PlugPress' },
    { href: SITE.saddle, label: 'Saddle' },
    { href: `mailto:${SITE.email}`, label: 'Contact' },
    { href: '/llms.txt', label: 'llms.txt' },
  ] },
];
---
<footer class="bg-background sm:px-6">
  <Container class="flex flex-col gap-10 pt-14 pb-12 md:flex-row md:justify-between">
    <div class="grid max-w-[22em] content-start gap-3.5">
      <Brand />
      <p class="text-[15px] text-muted-foreground">{SITE.definition}</p>
    </div>
    <div class="grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-3 sm:gap-x-16">
      {cols.map((c) => (
        <nav class="grid content-start gap-0.5" aria-label={c.title}>
          <h2 class="mb-2 text-[14px] font-medium">{c.title}</h2>
          {c.links.map((l) => <a class="py-1 text-[15px] text-muted-foreground no-underline hover:text-foreground" href={l.href}>{l.label}</a>)}
        </nav>
      ))}
    </div>
  </Container>
  <Container class="flex flex-col gap-1.5 border-t border-border py-6 text-[14px] text-gray md:flex-row md:justify-between">
    <span>{SITE.requires} · use your own AI key or ours</span>
    <span>© {year} {SITE.company}. Bridle is GPL.</span>
  </Container>
</footer>
