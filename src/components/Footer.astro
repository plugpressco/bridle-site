---
// The footer (design v3): the mark and the fine print, then four short
// columns of plain links.
import Mark from './Brand.astro';
import { SITE } from '../data/site';
const year = new Date().getFullYear();
const cols = [
  { title: 'Product', links: [
    { href: '/#email', label: 'Email replies' },
    { href: '/chat/', label: 'Bridle Chat' },
    { href: '/demo/', label: 'Live demo' },
    { href: '/pricing/', label: 'Pricing' },
  ] },
  { title: 'Resources', links: [
    { href: '/guides/', label: 'Guides' },
    { href: '/llms.txt', label: 'llms.txt' },
  ] },
  { title: 'Company', links: [
    { href: SITE.companyUrl, label: 'PlugPress' },
    { href: SITE.saddle, label: 'Saddle' },
    { href: `mailto:${SITE.email}`, label: 'Contact' },
  ] },
  { title: 'Legal', links: [
    { href: '/privacy/', label: 'Privacy' },
    { href: '/terms/', label: 'Terms' },
    { href: '/terms/#refunds', label: 'Refunds' },
  ] },
];
---
<footer class="foot">
  <div class="wrap">
    <div><Mark /><p class="small mt-2.5">© {year} {SITE.company}. Bridle is GPL.</p></div>
    {cols.map((c) => (
      <nav aria-label={c.title}>
        <h2>{c.title}</h2>
        {c.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    ))}
  </div>
</footer>
