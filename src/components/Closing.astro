---
// The closing call (home 08-copy.md §9, and the end of the inner pages): one
// centred call on a full-bleed sand band, with the warm dot art rising under it (owner,
// 2026-11-10: cleaner, more logical; the cut-off chat picture went). Before
// launch the button is the waitlist form (id="join", the menu's target).
import Button from './ui/Button.astro';
import Waitlist from './Waitlist.astro';
import { LAUNCHED, FREE_URL } from '../data/site';
interface Props { title?: string; second?: string; sub?: string; source?: string; wrap?: boolean }
const {
  title = 'Try it on your own inbox.',
  second,
  sub = '',
  source = 'footer',
  wrap = false,
} = Astro.props;
const Outer = wrap ? 'div' : Fragment;
const outer = wrap ? { class: 'wrap pt-8 md:pt-12' } : {};
---
<Outer {...outer}><section class="panel closer bleed" id="join" aria-labelledby="h-close">
  <div class="closing">
    <h2 class="h2" id="h-close">{title}{second && <> <span class="soft">{second}</span></>}</h2>
    {sub && <p class="sub">{sub}</p>}
    {LAUNCHED
      ? <div class="ctas justify-center"><Button size="lg" arrow href={FREE_URL}>Get Bridle free</Button><Button size="lg" variant="dark" href="/demo/">Try the live demo</Button></div>
      : <Waitlist source={source} />}
  </div>
</section></Outer>
