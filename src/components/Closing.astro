---
// The closing call (home 08-copy.md §9, and the end of the inner pages): a
// soft blue panel with the next step and Bridle Chat open beside it. Before
// launch the button is the waitlist form (id="join", the menu's target).
import Button from './ui/Button.astro';
import Waitlist from './Waitlist.astro';
import { LAUNCHED, WPORG_URL } from '../data/site';
interface Props { title?: string; second?: string; sub?: string; source?: string; wrap?: boolean }
const {
  title = 'Try it on your own inbox.',
  second,
  sub = 'Install it, forward one address, and see your first reply.',
  source = 'footer',
  wrap = false,
} = Astro.props;
const Outer = wrap ? 'div' : Fragment;
const outer = wrap ? { class: 'wrap pt-9 pb-[72px] md:pt-[60px] md:pb-[120px]' } : {};
---
<Outer {...outer}><section class="panel" id="join" aria-labelledby="h-close">
  <div class="closing">
    <div class="txt">
      <div><h2 class="h2" id="h-close">{title}{second && <> <span class="soft">{second}</span></>}</h2><p class="sub">{sub}</p></div>
      {LAUNCHED
        ? <div class="ctas"><Button size="lg" arrow href={WPORG_URL}>Get Bridle free</Button><Button size="lg" variant="white" href="/demo/">Try the live demo</Button></div>
        : <><Waitlist source={source} /><div class="ctas -mt-2"><a class="lnk" href="/demo/">Try the live demo ›</a></div></>}
    </div>
    <div class="chat"><div class="win"><picture><source srcset="/img/chat-answer.avif" type="image/avif" /><img src="/img/chat-answer.webp" width="400" height="680" alt="Bridle’s chat on a website, answering a question with a numbered source." loading="lazy" decoding="async" /></picture></div></div>
  </div>
</section></Outer>
