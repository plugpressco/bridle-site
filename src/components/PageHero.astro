---
// An inner page's opening (design v3): kicker, two-tone title, lead, the main
// button and a second link, beside one real Bridle screen at its real size in
// a soft blue panel, cropped by the panel's edge. Before launch the main
// button joins the waitlist (#join, the closing form) unless `cta` is given.
import HeadingPair from './ui/HeadingPair.astro';
import Button from './ui/Button.astro';
import Shot from './Shot.astro';
import { LAUNCHED, FREE_URL } from '../data/site';
interface Props {
  eyebrow: string;
  title: [string, string];
  lead: string;
  shot: { name: string; width: number; height: number; alt: string };
  more?: { href: string; label: string };
  cta?: { href: string; label: string };
}
const { eyebrow, title, lead, shot, more, cta } = Astro.props;
const main = cta || (LAUNCHED ? { href: FREE_URL, label: 'Get Bridle free' } : { href: '#join', label: 'Join the waitlist' });
---
<div class="wrap"><section class="hero pb-8 md:pb-12" aria-labelledby="h-page">
  <div class="copy">
    <HeadingPair as="h1" id="h-page" size="title" eyebrow={eyebrow} first={title[0]} second={title[1]} lead={lead} />
    <div class="ctas"><Button size="lg" arrow href={main.href}>{main.label}</Button>{more && <Button size="lg" variant="soft" href={more.href}>{more.label}</Button>}</div>
  </div>
  <div class="panel h-[420px] md:h-[520px]"><div class="absolute top-8 left-6 md:top-12 md:left-12"><Shot name={shot.name} width={shot.width} height={shot.height} alt={shot.alt} eager /></div></div>
</section></div>
