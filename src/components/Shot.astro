---
// A real Bridle screen, shot at 2x from the seeded demo (Fernleaf, a
// made-up shop), shown at its real size (half its pixels), AVIF with a WebP
// fallback. `flush` lets a panel's edge crop its bottom.
interface Props { name: string; width: number; height: number; alt: string; flush?: boolean; eager?: boolean; class?: string }
const { name, width, height, alt, flush = true, eager = false, class: cls } = Astro.props;
---
<picture>
  <source srcset={`/img/${name}.avif`} type="image/avif" />
  <img class:list={['screen', flush && 'flush', cls]} src={`/img/${name}.webp`} width={width} height={height} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
</picture>
