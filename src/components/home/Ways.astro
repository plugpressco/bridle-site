---
// 2 Three ways: every email lands in one of the app's three places. Ready to
// send (a draft waits), Needs you (Bridle never sends these) and Updates or
// Spam (filed away). The small stitched tab on each card is the brand's
// leather strap, in the colour of its place.
const ways = [
  { tone: 'blue', name: 'Ready to send', text: 'The reply is written from your docs, every fact checked. Read it, then send it.', rows: [
    { i: 'MC', c: '#5bb88a', n: 'Maya Chen', s: 'Gallery is blank on Safari 17' },
    { i: 'LM', c: '#b276c9', n: 'Lucas Moreau', s: 'Can I use it on a staging site?' },
    { i: 'BT', c: '#6a9e5a', n: 'Ben Turner', s: 'Do updates come with Pro?' },
  ] },
  { tone: 'brass', name: 'Needs you', text: 'Refunds, billing and upset customers. Bridle never sends these. A person answers.', rows: [
    { i: 'SR', c: '#8b7fd6', n: 'Sofia Rossi', s: 'Third time asking, my shop is down', tag: ['amber', 'Upset'] },
    { i: 'JB', c: '#c98a5b', n: 'Jonas Berg', s: 'Refund for order 2187', tag: ['amber', 'Refund'] },
  ] },
  { tone: 'grey', name: 'Filed away', text: 'Receipts go to Updates. Scams go to Spam. Your Inbox shows only people.', rows: [
    { n: 'Stripe', s: 'Your receipt from Fernleaf #2041', tag: ['grey', 'Updates'] },
    { n: 'WooCommerce', s: 'New order #2188', tag: ['grey', 'Updates'] },
    { n: 'Growth Pros', s: 'Boost your SEO in 7 days', tag: ['grey', 'Spam'] },
  ] },
];
---
<section class="band" aria-labelledby="h-ways">
  <div class="opener"><h2 class="h2" id="h-ways">Every email goes one of <span class="soft">three ways.</span></h2><p class="sub">Bridle reads each one and picks the way. You always see where it went.</p></div>
  <div class="ways">
    {ways.map((w) => (
      <div class="way">
        <span class:list={['strap', w.tone]} aria-hidden="true"></span>
        <h3 class="h3">{w.name}</h3>
        <p>{w.text}</p>
        <div class="wstage" aria-hidden="true">
          <div class="pcard">
            {w.rows.map((r) => <div class="prow">{r.i && <span class="pava" style={`background:${r.c}`}>{r.i}</span>}<div class="pt"><b>{r.n}</b><span>{r.s}</span></div>{r.tag && <span class:list={['ptag', r.tag[0]]}>{r.tag[1]}</span>}</div>)}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
