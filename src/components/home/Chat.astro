---
// Bridle Chat on the home page: three facts beside the bubble, playing.
import ChatDemo from '../ChatDemo.astro';
const points = [
  { icon: 'i-book', text: 'Answers from your docs' },
  { icon: 'i-check-circle', text: 'Only checked answers' },
  { icon: 'i-user', text: 'Hands the hard ones to you' },
];
---
<section class="block" id="chat" aria-labelledby="h-chat">
  <div class="head">
    <p class="eyebrow">Bridle Chat</p>
    <h2 id="h-chat"><span>A chat that answers</span><span class="g">And knows when to call you</span></h2>
  </div>
  <div class="wrap chatrow">
    <div class="points">
      <ul>
        {points.map((p) => <li><svg class="i"><use href={`#${p.icon}`} /></svg>{p.text}</li>)}
      </ul>
      <a class="tlink blue" href="/chat/">How the chat works</a>
    </div>
    <ChatDemo />
  </div>
</section>
