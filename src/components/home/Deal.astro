---
// 6 The Black Friday deal: the page's one blue panel (owner, 2026-11-10: "make
// better color with better presentation ... creative and attractive ... a
// little more FOMO and easy to understand"). Warm dots on the blue, a live
// countdown to the real end (deal.json endsAt), the 1 · 3 · 10 sites switch,
// the next prices so the rise is plain to see, and the safety lines. Sales
// left at this price show only once /api/deal is live (src/scripts/deal.js).
// Before launch the button joins the waitlist.
import Button from '../ui/Button.astro';
import Dither from '../Dither.astro';
import { PRO, LAUNCHED, money, count, sitesLabel, inboxesLabel } from '../../data/site';
interface Props { join: string }
const { join } = Astro.props;
const one = PRO.plans[0];
---
<section class="panel blue bleed" aria-labelledby="h-deal" data-deal data-ends={PRO.endsAt}>
  <Dither tone="night" from="right" />
  <div class="deal">
    <div class="dtext">
      <span class="bf">Black Friday</span>
      <h2 class="h2" id="h-deal">Pay once for Bridle Pro.</h2>
      <p class="sub">Only until Cyber Monday.</p>
      <div class="cd" data-cd hidden role="timer" aria-label="Time left in the deal">
        <div><b class="tab" data-cd-d>00</b><span>days</span></div>
        <div><b class="tab" data-cd-h>00</b><span>hours</span></div>
        <div><b class="tab" data-cd-m>00</b><span>minutes</span></div>
        <div><b class="tab" data-cd-s>00</b><span>seconds</span></div>
      </div>
      <div class="what"><b>What Pro adds</b>
        <span><svg aria-hidden="true"><use href="#d-check" /></svg>Chat on your other sites</span>
        <span><svg aria-hidden="true"><use href="#d-check" /></svg>Live chat, with your hours</span>
        <span><svg aria-hidden="true"><use href="#d-check" /></svg>Order and licence lookups</span>
        <span><svg aria-hidden="true"><use href="#d-check" /></svg>More inboxes</span>
      </div>
    </div>
    <div class="dcard">
      <div class="sw" role="group" aria-label="Sites">
        {PRO.plans.map((p, i) => <button type="button" data-sites={p.key} aria-pressed={i === 0 ? 'true' : 'false'}>{sitesLabel(p.sites)}</button>)}
      </div>
      <div class="dprice"><b data-pro="price">{money(one.base)}</b><span data-pro="unit">pay once, for {sitesLabel(one.sites)}</span></div>
      <p class="incl">With <span data-pro="answers">{count(one.answers)}</span> AI answers and <span data-pro="inboxes">{inboxesLabel(one.inboxes)}</span>.</p>
      <ol class="steps-up" aria-label="The price goes up every 20 sales">
        <li class="now"><span>Now</span><b data-pro="price">{money(one.base)}</b></li>
        <li><span>Next</span><b data-pro="next">{money(one.base + PRO.rise)}</b></li>
        <li><span>Then</span><b data-pro="next2">{money(one.base + 2 * PRO.rise)}</b></li>
      </ol>
      <p class="rise">The price goes up {money(PRO.rise)} every 20 sales.</p>
      <div class="left" data-counters hidden><span data-left-box hidden><b class="tab" data-left></b> <span data-left-label>left at {money(one.base)}</span></span><div class="prog" data-prog hidden aria-hidden="true"><i></i></div></div>
      {LAUNCHED
        ? <Button size="lg" arrow href={`/api/checkout?plan=${one.key}`} data-buy="follow" data-buy-label="Get Bridle Pro, {price}">Get Bridle Pro, {money(one.base)}</Button>
        : <Button size="lg" arrow href={join}>Join the waitlist</Button>}
      <ul class="safe">
        <li><svg aria-hidden="true"><use href="#d-check" /></svg>{PRO.refundDays}-day refund</li>
        <li><svg aria-hidden="true"><use href="#d-check" /></svg>Updates for life</li>
        <li><svg aria-hidden="true"><use href="#d-check" /></svg>No subscription</li>
      </ul>
      <a class="all" href="/pricing/">See all plans ›</a>
    </div>
  </div>
</section>

<script>
  import '../../scripts/deal.js';
</script>
