      <p class="b">Refunds, billing and upset customers always go to you.</p>
    </div>
    <div class="vis"><Shot name="conversation-draft" width={803} height={723} alt="A Bridle draft for Priya, high confidence and verified, with the help doc it came from." /></div>
  </div>
</section>
