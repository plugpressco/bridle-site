// with the real draft and its source. Facts: AgentPrompt::verify(),
// AutoSend::TRIPWIRE, ChatPolicy::decide() in the plugin.
import Shot from '../Shot.astro';
---
<section class="panel lined" aria-labelledby="h-checks">
  <div class="checks">
    <div class="txt">
      <div><h2 class="h2" id="h-checks">It checks before it speaks.</h2><p class="sub">No fact without a source.</p></div>
