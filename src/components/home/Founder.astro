---
// 7 A note from the founder, as a quote (owner, 2026-11-10: the email card
// looked "worried ... not professional"). The lines were confirmed true by the
// owner on 10 November 2026. Plain on the page, like the questions.
import { SITE } from '../../data/site';
---
<section class="band plain" aria-labelledby="h-founder">
  <div class="founder">
    <img class="fphoto" src="/fahim.jpg" width="120" height="120" alt="Fahim Reza" loading="lazy" decoding="async" />
    <div class="fq">
      <h2 class="sr-only" id="h-founder">A note from the founder.</h2>
      <blockquote><p>“Every day we answer the same questions by email. So we built Bridle for our own inbox.”</p></blockquote>
      <p class="fbody">It writes the reply. We check it and send it. Bridle is free, and it stays free.</p>
      <div class="fsig"><b>Fahim Reza</b><span>Founder, PlugPress. The team behind Saddle and Mailpuff.</span></div>
      <a class="lnk" href={`mailto:${SITE.email}`}>Write to Fahim ›</a>
    </div>
  </div>
</section>
