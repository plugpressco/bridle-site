---
// Bring your own agent: pick a logo, watch that agent answer through Bridle
// (src/scripts/home.js, agents()).
const apps = [
  { key: 'chatgpt', name: 'ChatGPT', logo: 'l-openai' },
  { key: 'claude', name: 'Claude', logo: 'l-claude', on: true },
  { key: 'codex', name: 'Codex', logo: 'l-codex' },
  { key: 'cursor', name: 'Cursor', logo: 'l-cursor' },
];
---
<section class="block" id="agents" aria-labelledby="h-agents">
  <div class="head">
    <p class="eyebrow">Use your own AI</p>
    <h2 id="h-agents"><span>Works with Claude and ChatGPT</span><span class="g">Nothing sends without you</span></h2>
  </div>
  <div class="wrap agents" id="agents-demo">
    <div class="pick">
      <p class="lead">Answer support right from the AI app you use.</p>
      <div class="apps" role="group" aria-label="Pick an agent to see it work">
        {apps.map((a) => (
          <button type="button" class="app" data-agent={a.key} aria-pressed={a.on ? 'true' : 'false'}><span class="tile"><svg aria-hidden="true"><use href={`#${a.logo}`} /></svg></span>{a.name}</button>
        ))}
        <span class="app more"><span class="tile"><svg aria-hidden="true"><use href="#l-mcp" /></svg></span>Any AI app</span>
      </div>
    </div>
    <div class="stage">
      <figure class="chat" id="agent-chat" aria-label="Claude answers a customer through Bridle: it reads the email, finds the answer in your docs and saves a reply. It waits for your OK to send." style="margin:0">
        <div class="chat-top" aria-hidden="true">
          <span class="agent"><svg><use data-logo href="#l-claude" /></svg><b data-name>Claude</b></span>
          <span class="linked"><svg><use href="#mark" /></svg>Bridle connected</span>
        </div>
        <div class="chat-body" aria-hidden="true">
          <p class="ask">Answer Leo’s email.</p>
          <div class="turn">
            <span class="av"><svg><use data-logo href="#l-claude" /></svg></span>
            <ol class="steps"></ol>
          </div>
        </div>
      </figure>
    </div>
  </div>
</section>
