---
// Bring your own agent: pick a logo, watch that agent answer through Bridle
// (src/scripts/home.js, agents()). The chat's moving parts are styled in
// site.css (#agents-demo).
import Section from '../ui/Section.astro';
import HeadingPair from '../ui/HeadingPair.astro';
const apps = [
  { key: 'chatgpt', name: 'ChatGPT', logo: 'l-openai' },
  { key: 'claude', name: 'Claude', logo: 'l-claude', on: true },
  { key: 'codex', name: 'Codex', logo: 'l-codex' },
  { key: 'cursor', name: 'Cursor', logo: 'l-cursor' },
];
const app = 'app flex flex-col items-center gap-2 text-[12.5px] text-muted-foreground transition-colors sm:text-[14px]';
---
<Section id="agents" labelledby="h-agents">
  <HeadingPair id="h-agents" eyebrow="Use your own AI" first="Works with Claude and ChatGPT" second="Nothing sends without you" class="mb-10 md:mb-14" />
  <div class="grid items-center gap-9 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-14" id="agents-demo">
    <div>
      <p class="max-w-[22em] text-lead text-ink-2">Answer support right from the AI app you use.</p>
      <div class="mt-8 flex flex-wrap justify-between gap-x-2.5 gap-y-4 sm:justify-start sm:gap-x-4" role="group" aria-label="Pick an agent to see it work">
        {apps.map((a) => (
          <button type="button" class:list={[app, 'cursor-pointer hover:text-foreground aria-pressed:text-foreground']} data-agent={a.key} aria-pressed={a.on ? 'true' : 'false'}><span class="tile"><svg aria-hidden="true"><use href={`#${a.logo}`} /></svg></span>{a.name}</button>
        ))}
        <span class:list={[app, 'more']}><span class="tile"><svg aria-hidden="true"><use href="#l-mcp" /></svg></span>Any AI app</span>
      </div>
    </div>
    <div class="rounded-card bg-brand-50 px-3 py-7 sm:px-10 sm:py-11">
      <figure class="m-0 overflow-hidden rounded-card border border-border bg-card shadow-soft" id="agent-chat" aria-label="Claude answers a customer through Bridle: it reads the email, finds the answer in your docs and saves a reply. It waits for your OK to send.">
        <div class="flex h-[54px] items-center justify-between gap-3 border-b border-border bg-secondary px-[18px]" aria-hidden="true">
          <span class="inline-flex items-center gap-2 text-[16px]"><svg class="size-5 text-foreground"><use data-logo href="#l-claude" /></svg><b class="font-medium" data-name>Claude</b></span>
          <span class="inline-flex items-center gap-[7px] whitespace-nowrap rounded-full border border-border bg-card py-1 pr-[11px] pl-2 font-mono text-[12px] text-muted-foreground"><svg class="size-3.5 text-brand-500"><use href="#mark" /></svg>Bridle connected</span>
        </div>
        <div class="chat-body" aria-hidden="true">
          <p class="ask">Answer Leo’s email.</p>
          <div class="flex items-start gap-3">
            <span class="grid size-8 flex-none place-items-center rounded-full border border-border bg-card text-foreground"><svg class="size-[18px]"><use data-logo href="#l-claude" /></svg></span>
            <ol class="steps"></ol>
          </div>
        </div>
      </figure>
    </div>
  </div>
</Section>
