---
// 3 It also answers on your website: Bridle Chat and Bridle KB, each shown
// with a short real example, then one line and a plain link.
import SecHead from '../ui/SecHead.astro';
---
<section class="band" aria-labelledby="h-onsite">
  <SecHead id="onsite" title="It also answers on your website" line="The same answers, in a chat bubble and in a help center your customers can search." />
  <div class="duo">
    <div>
      <div class="dpanel" aria-hidden="true">
        <div class="pcard dchat">
          <div class="cbar"><span class="pava sm" style="background:rgb(255 255 255 / 0.2)">F</span><div><b>Fernleaf</b><small>AI assistant · a person can help</small></div></div>
          <div class="cbody">
            <div class="bub v">Can I use it on a staging site?</div>
            <div class="bub b">Yes. Staging sites don’t count against your licence.<div class="bsrc"><span class="n">1</span>Help doc: Use it on a staging site</div></div>
            <div class="bub v">I want a refund.</div>
            <div class="bub b">A person will reply here.</div>
          </div>
        </div>
      </div>
      <h3 class="h3">Chat on your site</h3>
      <p>Answers visitors from your docs, day and night. Refunds and hard questions go to you.</p>
      <a class="lnk" href="/chat/">How Chat works</a>
    </div>
    <div>
      <div class="dpanel sand" aria-hidden="true">
        <div class="pcard ddocs">
          <aside><div class="q"><span>Search docs</span><span>/</span></div><b>Getting started</b><span>Install Fernleaf Gallery</span><span class="on">Use it on a staging site</span><span>Move to a new site</span><b>Billing</b><span>Refunds</span></aside>
          <div class="dmain"><small>Getting started</small><h4>Use it on a staging site</h4><p>Staging and local sites don’t count against your licence. Only live sites count.</p></div>
        </div>
      </div>
      <h3 class="h3">A help center</h3>
      <p>Write your docs once. Customers search them, and Bridle answers from them.</p>
      <a class="lnk" href="/knowledge-base/">How the help center works</a>
    </div>
  </div>
</section>
