---
// Three small dot stories (src/scripts/home.js, cells()).
const cells = [
  { art: 'sort', title: 'Sorted on arrival', text: 'Receipts and spam filed away.' },
  { art: 'draft', title: 'Answers from your docs', text: 'Every fact checked.' },
  { art: 'send', title: 'Sends when it’s sure', text: 'Refunds wait for you.' },
];
---
<section class="block" aria-label="How Bridle works">
  <div class="wrap flush"><div class="cells">
    {cells.map((c) => (
      <div class="cell">
        <div class="art" data-art={c.art}><canvas class="dots" aria-hidden="true"></canvas></div>
        <h3>{c.title}</h3>
        <p>{c.text}</p>
      </div>
    ))}
  </div></div>
</section>
