---
// Three small dot stories (src/scripts/home.js, cells()).
const cells = [
  { art: 'sort', title: 'Sorted on arrival', text: 'Receipts, newsletters and spam are filed away. Your Inbox only holds customers.' },
  { art: 'draft', title: 'Answers from what you know', text: 'Every reply comes from your docs, products and past answers. Nothing made up.' },
  { art: 'send', title: 'Sends when it’s sure', text: 'In Auto, confident answers go out on their own. Refunds and upset customers wait for you.' },
];
---
<section class="block" aria-label="How Bridle works">
  <div class="wrap flush"><div class="cells">
    {cells.map((c) => (
      <div class="cell">
        <div class="art" data-art={c.art}><canvas class="dots" aria-hidden="true"></canvas></div>
        <h3>{c.title}</h3>
        <p>{c.text}</p>
      </div>
    ))}
  </div></div>
</section>
