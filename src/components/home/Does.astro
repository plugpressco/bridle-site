---
// 2 What it does (08-copy.md §2): one big real screen, then the six as a
// quiet list. One picture, more space (owner after v2: "too busy").
import Shot from '../Shot.astro';
import Dither from '../Dither.astro';
const items = [
  { name: 'Ready to send', text: 'Replies wait for you, already written.' },
  { name: 'Knows your business', text: 'It reads your docs, pages, products and past replies.' },
  { name: 'Sorts your mail', text: 'Receipts go to Updates. Scams go to Spam.' },
  { name: 'Chat on your site', text: 'It answers visitors from the same docs.' },
];
---
<section class="band" id="email" aria-labelledby="h-does">
  <div class="opener"><h2 class="h2" id="h-does">Every email comes with a reply.</h2><p class="sub">Read it, then send it.</p></div>
  <div class="panel big"><Dither /><Shot name="inbox-groups" width={820} height={566} alt="Ready to send in Bridle: four replies with Draft ready, and a refund under Needs you." /></div>
  <div class="flist four">
    {items.map((i) => <div><h3>{i.name}</h3><p>{i.text}</p></div>)}
  </div>
</section>
