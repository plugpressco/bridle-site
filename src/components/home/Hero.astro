---
// 1 Hero (08-copy.md §1, headline A): the copy on the left; on the right the
// one moving picture, the product working: an email arrives, the reply writes
// itself with two checked sources, Send, then a refund goes to Needs you.
// Drawn at the app's own size from its styles; flat; a pause button; with
// reduced motion it rests on its last frame (src/scripts/hero.js).
import Button from '../ui/Button.astro';
import Waitlist from '../Waitlist.astro';
import Dither from '../Dither.astro';
import { LAUNCHED, WPORG_URL } from '../../data/site';
const use = (id: string) => `<svg aria-hidden="true"><use href="#${id}"/></svg>`;
---
<section class="hero" aria-labelledby="h-hero">
  <div class="copy">
    <p class="kicker">AI support agent for WordPress</p>
    <h1 class="h1" id="h-hero">Your support email answers itself. <span class="soft">You check the hard ones.</span></h1>
    <p class="lead">Bridle writes each reply from your docs, checks every fact and hands you the ones it can’t answer.</p>
    {LAUNCHED ? (
      <>
        <div class="ctas"><Button size="lg" arrow href={WPORG_URL}>Get Bridle free</Button><Button size="lg" variant="soft" href="/demo/">Try the live demo</Button></div>
        <p class="by">Built by the team behind Saddle.</p>
      </>
    ) : (
      <>
        <Waitlist source="hero" />
        <p class="by">Built by the team behind Saddle.</p>
      </>
    )}
  </div>
  <div class="panel hero-pic" role="img" aria-label="An email comes in, Bridle drafts a reply with its sources, and a refund question goes to a person.">
    <Dither />
    <div class="stage ui loop" id="loop" aria-hidden="true">
      <div class="letter m1">
        <div class="lhead"><svg class="face" data-seed="maya@example.com" viewBox="0 0 32 32"></svg><div class="who"><b>Maya Chen</b><span>to support@acmesliders.com</span></div><span class="when">9:12 AM</span></div>
        <p class="lbody">Hi! Where is my order? I bought it on Monday.</p>
      </div>
      <div class="draft d1">
        <div class="dhead"><svg class="face sm" data-bot viewBox="0 0 32 32"></svg><div><b>Bridle</b><span class="meta">Draft · High confidence · Verified</span></div><span class="chips"><span class="chip ready c-ready"><Fragment set:html={use('d-spark')} />Draft ready</span><span class="chip sent c-sent"><Fragment set:html={use('d-check')} />Sent</span></span></div>
        <div class="typing"><i></i><i></i><i></i></div>
        <p class="dbody">Hi Maya, orders ship within 2 working days<sup>1</sup>. You can track yours from the link in your receipt<sup>2</sup>.</p>
        <div class="srcs-wrap grid gap-2"><span class="hide-src">Hide sources</span>
          <div class="srcs">
            <div class="src"><span class="n">1</span><b>Help doc <small>· Shipping times</small></b><em>✓ Checked</em></div>
            <div class="src"><span class="n">2</span><b>Help doc <small>· Where is my order?</small></b><em>✓ Checked</em></div>
          </div>
        </div>
        <div class="dacts"><span class="send"><Fragment set:html={use('d-send')} />Send as is</span><span><Fragment set:html={use('d-edit')} />Edit</span><span><Fragment set:html={use('d-wand')} />Rewrite</span><span><Fragment set:html={use('d-redo')} />Redraft</span><span class="right"><Fragment set:html={use('d-trash')} />Discard</span></div>
      </div>
      <div class="m2">
        <p class="glabel">Needs you <span>1</span></p>
        <div class="irow"><svg class="face" data-seed="tom@shop.test" viewBox="0 0 32 32"></svg><div class="t"><b>Tom Price<small>Refund for last month</small></b><span><span class="chip need c-need"><Fragment set:html={use('d-alert')} />Refund</span>Can I get a refund for last month?</span></div><time>2m</time></div>
      </div>
    </div>
    <button type="button" class="pause" id="pause" aria-label="Pause the animation"><svg aria-hidden="true"><use href="#d-pause" /></svg></button>
  </div>
</section>

<script>
  import '../../scripts/faces.js';
  import '../../scripts/hero.js';
</script>
