---
// 1 Hero ("tack" design, owner's pick 2026-11-11): the headline, one line
// and two buttons on the left; on the right the product itself, drawn as
// crisp cards on a soft blue panel: the Inbox with replies ready and a refund
// that needs you, and in front the reply to Maya with its checked source.
// Names are the made-up Fernleaf business used across the site.
import Button from '../ui/Button.astro';
import { LAUNCHED, FREE_URL } from '../../data/site';
const ready = [
  { i: 'MC', c: '#5bb88a', n: 'Maya Chen', s: 'Gallery is blank on Safari 17' },
  { i: 'LM', c: '#b276c9', n: 'Lucas Moreau', s: 'Can I use it on a staging site?' },
  { i: 'BT', c: '#6a9e5a', n: 'Ben Turner', s: 'Do updates come with Pro?' },
];
---
<section class="thero" aria-labelledby="h-hero">
  <div class="copy">
    <h1 class="h1" id="h-hero">Your support email answers itself. <span class="soft">You check the hard ones.</span></h1>
    <p class="lead">Bridle writes each reply from your docs and checks every fact. Refunds, billing and upset customers always wait for you.</p>
    <div class="ctas">
      {LAUNCHED ? <Button size="lg" arrow href={FREE_URL}>Get Bridle free</Button> : <Button size="lg" arrow href="#join">Join the waitlist</Button>}
      <Button size="lg" variant="line" href="/demo/">Try the live demo</Button>
    </div>
    <p class="small">Free for WordPress · Built by the team behind Saddle</p>
  </div>
  <div class="tstage" role="img" aria-label="The Bridle inbox: three replies ready to send and a refund that needs you. In front, the reply to Maya with its checked help doc source.">
    <div class="pcard tinbox" aria-hidden="true">
      <div class="tibar">Inbox <span>Support</span></div>
      <div class="tglabel">Ready to send <i>3</i></div>
      {ready.map((r) => <div class="prow"><span class="pava" style={`background:${r.c}`}>{r.i}</span><div class="pt"><b>{r.n}</b><span>{r.s}</span></div><span class="ptag blue">Draft ready</span></div>)}
      <div class="tglabel">Needs you <i>1</i></div>
      <div class="prow"><span class="pava" style="background:#c98a5b">JB</span><div class="pt"><b>Jonas Berg</b><span>Refund for order 2187</span></div><span class="ptag amber">Refund</span></div>
    </div>
    <div class="pcard pdraft tfront" aria-hidden="true">
      <div class="ptop"><span class="pava sm">B</span><b>Reply to Maya</b><span class="ptag green">✓ Facts checked</span></div>
      <p>Hi Maya, clear your cache plugin and turn off “Lazy load images” under Fernleaf → Performance.<sup>1</sup> Version 3.4.2 fixes it for good.<sup>1</sup></p>
      <div class="psrc"><span class="n">1</span><span><b>Help doc</b> · Gallery not showing on Safari</span></div>
      <div class="pacts"><span class="go">Send</span><span>Edit</span><span>Rewrite</span></div>
    </div>
  </div>
</section>
