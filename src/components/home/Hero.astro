---
// The dot field: support mail drifts in as a tangle, threads through the mark
// and leaves as three calm reins (src/scripts/home.js, hero()).
import Waitlist from '../Waitlist.astro';
---
<div class="hero" id="hero">
  <canvas class="dots" aria-hidden="true"></canvas>
  <div class="wrap intro" data-mask>
    <p class="eyebrow r" data-mask>AI support for <b>WordPress</b></p>
    <h1 class="r" style="--d:.05s"><span data-mask>AI writes the replies</span><span class="g" data-mask>You hold the reins</span></h1>
    <div class="under">
      <p class="lead r" style="--d:.12s" data-mask>It answers your support email and chat. The hard ones come to you.</p>
      <div class="r" style="--d:.18s" data-mask><Waitlist source="hero" /><a class="tlink demo-link" href="/demo/">Try the live demo</a></div>
    </div>
  </div>

  <figure class="band" id="band" style="margin:0">
    <figcaption class="sr">Mail comes in as a mess of dots. Bridle sorts it into three rows: answered, waiting for you, and filed away.</figcaption>
    <div class="gate" aria-hidden="true"><svg><use href="#mark-gate" /></svg></div>
    <div class="lane" data-k="sent" aria-hidden="true"><i></i><span>Answered</span><b>0</b></div>
    <div class="lane" data-k="mine" aria-hidden="true"><i></i><span>Waits for you</span><b>0</b></div>
    <div class="lane" data-k="filed" aria-hidden="true"><i></i><span>Filed away</span><b>0</b></div>
    <div class="tip" aria-hidden="true"></div>
  </figure>
</div>
